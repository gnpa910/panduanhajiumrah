---
// ChatBot.astro — floating AI chat widget for panduanhajiumrah
// Client-only interactive component, no server props needed
---

<button
  id="chatbot-fab"
  aria-label="Tanya Panduan Haji"
  class="fixed bottom-5 right-5 z-50 w-14 h-14 rounded-full bg-[#0d7377] text-white shadow-lg hover:bg-[#095e61] transition-all duration-200 flex items-center justify-center print:hidden"
>
  <svg id="chatbot-icon-open" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
  </svg>
  <svg id="chatbot-icon-close" class="w-7 h-7 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
  </svg>
</button>

<!-- Chat Window -->
<div
  id="chatbot-window"
  class="fixed bottom-24 right-5 z-50 w-[min(380px,calc(100vw-2rem))] h-[min(520px,calc(100vh-8rem))] bg-white dark:bg-[var(--color-ink)] border border-stone-200 dark:border-stone-700 rounded-2xl shadow-2xl flex flex-col overflow-hidden transition-all duration-300 origin-bottom-right print:hidden"
  style="display: none; opacity: 0; transform: scale(0.9);"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-4 py-3 bg-[#0d7377] text-white shrink-0">
    <div class="flex items-center gap-2">
      <span class="text-lg">🕌</span>
      <div>
        <p class="font-semibold text-sm leading-tight">Tanya Panduan Haji</p>
        <p class="text-[11px] opacity-80 leading-tight">AI assistant · Bukan fatwa rasmi</p>
      </div>
    </div>
    <button id="chatbot-close" aria-label="Tutup" class="p-1 rounded hover:bg-white/20 transition">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  </div>

  <!-- Messages -->
  <div id="chatbot-messages" class="flex-1 overflow-y-auto px-4 py-3 space-y-3 text-sm scroll-smooth">
    <!-- Welcome message -->
    <div class="flex gap-2 items-start">
      <span class="text-base shrink-0 mt-0.5">🤖</span>
      <div class="bg-stone-100 dark:bg-stone-800 rounded-xl rounded-tl-sm px-3 py-2 max-w-[85%] text-[var(--color-ink)] dark:text-stone-200 leading-relaxed">
        <p>Assalamualaikum! 👋 Saya Panduan Haji AI.</p>
        <p class="mt-1">Boleh tanya apa sahaja tentang haji & umrah — rukun, tatacara, fiqh, persiapan, atau guna alat di laman kami.</p>
      </div>
    </div>

    <!-- Suggested questions -->
    <div id="chatbot-suggestions" class="flex flex-wrap gap-2 pl-7">
      <button class="chatbot-suggestion text-xs px-3 py-1.5 rounded-full border border-[#0d7377] text-[#0d7377] dark:border-teal-400 dark:text-teal-400 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition whitespace-nowrap">Apa rukun haji?</button>
      <button class="chatbot-suggestion text-xs px-3 py-1.5 rounded-full border border-[#0d7377] text-[#0d7377] dark:border-teal-400 dark:text-teal-400 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition whitespace-nowrap">Berapa kos umrah?</button>
      <button class="chatbot-suggestion text-xs px-3 py-1.5 rounded-full border border-[#0d7377] text-[#0d7377] dark:border-teal-400 dark:text-teal-400 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition whitespace-nowrap">Bolehkah wanita tanpa mahram?</button>
      <button class="chatbot-suggestion text-xs px-3 py-1.5 rounded-full border border-[#0d7377] text-[#0d7377] dark:border-teal-400 dark:text-teal-400 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition whitespace-nowrap">Bagaimana solat musafir?</button>
    </div>
  </div>

  <!-- Input Area -->
  <div class="shrink-0 border-t border-stone-200 dark:border-stone-700 px-3 py-2 bg-white dark:bg-[var(--color-ink)]">
    <div class="flex gap-2 items-end">
      <textarea
        id="chatbot-input"
        rows="1"
        placeholder="Taip soalan anda..."
        class="flex-1 resize-none rounded-xl border border-stone-300 dark:border-stone-600 bg-stone-50 dark:bg-stone-800 px-3 py-2 text-sm text-[var(--color-ink)] dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-[#0d7377] dark:focus:ring-teal-400 max-h-24 leading-relaxed"
      ></textarea>
      <button
        id="chatbot-send"
        aria-label="Hantar"
        class="shrink-0 w-9 h-9 rounded-xl bg-[#0d7377] text-white flex items-center justify-center hover:bg-[#095e61] disabled:opacity-40 disabled:cursor-not-allowed transition"
        disabled
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </button>
    </div>
    <p class="text-[10px] text-stone-400 dark:text-stone-500 mt-1 text-center">AI assistant — rujuk ustaz untuk keputusan agama</p>
  </div>
</div>

<script>
  // ── ChatBot client-side logic ──
  (function () {
    const fab = document.getElementById("chatbot-fab")!;
    const iconOpen = document.getElementById("chatbot-icon-open")!;
    const iconClose = document.getElementById("chatbot-icon-close")!;
    const win = document.getElementById("chatbot-window") as HTMLDivElement;
    const closeBtn = document.getElementById("chatbot-close")!;
    const msgContainer = document.getElementById("chatbot-messages")!;
    const suggestions = document.getElementById("chatbot-suggestions")!;
    const input = document.getElementById("chatbot-input") as HTMLTextAreaElement;
    const sendBtn = document.getElementById("chatbot-send") as HTMLButtonElement;

    let isOpen = false;
    let isLoading = false;
    const messages: { role: string; content: string }[] = [];

    /* ── Toggle ── */
    function toggle(open?: boolean) {
      isOpen = open ?? !isOpen;
      if (isOpen) {
        win.style.display = "flex";
        requestAnimationFrame(() => {
          win.style.opacity = "1";
          win.style.transform = "scale(1)";
        });
        iconOpen.classList.add("hidden");
        iconClose.classList.remove("hidden");
        input.focus();
      } else {
        win.style.opacity = "0";
        win.style.transform = "scale(0.9)";
        setTimeout(() => { win.style.display = "none"; }, 250);
        iconOpen.classList.remove("hidden");
        iconClose.classList.add("hidden");
      }
    }

    fab.addEventListener("click", () => toggle());
    closeBtn.addEventListener("click", () => toggle(false));

    /* ── Markdown-lite renderer ── */
    function renderMd(text: string): string {
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        // links [text](url)
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="underline text-[#0d7377] dark:text-teal-400 hover:opacity-80" target="_blank" rel="noopener">$1</a>')
        // bold
        .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
        // italic
        .replace(/\*(.+?)\*/g, "<em>$1</em>")
        // inline code
        .replace(/`([^`]+)`/g, '<code class="bg-stone-200 dark:bg-stone-700 px-1 rounded text-xs">$1</code>')
        // newlines
        .replace(/\n/g, "<br/>");
    }

    /* ── Add message to UI ── */
    function addMessage(role: string, content: string, streaming = false) {
      const wrapper = document.createElement("div");
      wrapper.className = "flex gap-2 items-start " + (role === "user" ? "justify-end" : "");

      const bubble = document.createElement("div");
      bubble.className =
        role === "user"
          ? "bg-[#0d7377] text-white rounded-xl rounded-tr-sm px-3 py-2 max-w-[85%] leading-relaxed"
          : "bg-stone-100 dark:bg-stone-800 text-[var(--color-ink)] dark:text-stone-200 rounded-xl rounded-tl-sm px-3 py-2 max-w-[85%] leading-relaxed chatbot-bot-bubble";

      if (role === "assistant") {
        const emoji = document.createElement("span");
        emoji.className = "text-base shrink-0 mt-0.5";
        emoji.textContent = "🤖";
        wrapper.appendChild(emoji);
      }

      bubble.innerHTML = renderMd(content);
      wrapper.appendChild(bubble);

      if (role === "user") {
        const emoji = document.createElement("span");
        emoji.className = "text-base shrink-0 mt-0.5";
        emoji.textContent = "👤";
        wrapper.appendChild(emoji);
      }

      // Remove streaming cursor if present
      const existingCursor = msgContainer.querySelector(".chatbot-cursor");
      if (existingCursor) existingCursor.remove();

      msgContainer.appendChild(wrapper);

      // Add streaming cursor for assistant
      if (streaming) {
        const cursor = document.createElement("span");
        cursor.className = "chatbot-cursor inline-block w-1.5 h-4 bg-[#0d7377] dark:bg-teal-400 animate-pulse ml-0.5 align-middle";
        bubble.appendChild(cursor);
      }

      msgContainer.scrollTop = msgContainer.scrollHeight;
      return bubble;
    }

    /* ── Send message ── */
    async function sendMessage(text: string) {
      if (!text.trim() || isLoading) return;

      const userText = text.trim();
      input.value = "";
      autoResize();
      sendBtn.disabled = true;

      // Hide suggestions on first message
      if (suggestions) suggestions.style.display = "none";

      // Add user message
      messages.push({ role: "user", content: userText });
      addMessage("user", userText);

      // Add assistant placeholder
      isLoading = true;
      const bubble = addMessage("assistant", "", true);

      try {
        const response = await fetch("/api/chat/", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages }),
        });

        if (!response.ok) {
          const err = await response.json().catch(() => ({}));
          throw new Error(err.detail || `HTTP ${response.status}`);
        }

        const reader = response.body!.getReader();
        const decoder = new TextDecoder();
        let fullContent = "";
        let buffer = "";

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split("\n");
          buffer = lines.pop() || "";

          for (const line of lines) {
            const trimmed = line.trim();
            if (!trimmed || !trimmed.startsWith("data:")) continue;
            const data = trimmed.slice(5).trim();
            if (data === "[DONE]") continue;

            try {
              const parsed = JSON.parse(data);
              const delta = parsed.choices?.[0]?.delta?.content;
              if (delta) {
                fullContent += delta;
                bubble.innerHTML = renderMd(fullContent);
                // Re-add cursor
                const cursor = document.createElement("span");
                cursor.className = "chatbot-cursor inline-block w-1.5 h-4 bg-[#0d7377] dark:bg-teal-400 animate-pulse ml-0.5 align-middle";
                bubble.appendChild(cursor);
                msgContainer.scrollTop = msgContainer.scrollHeight;
              }
            } catch {
              // Skip malformed chunks
            }
          }
        }

        // Remove cursor
        const cursor = msgContainer.querySelector(".chatbot-cursor");
        if (cursor) cursor.remove();

        if (fullContent) {
          messages.push({ role: "assistant", content: fullContent });
        } else {
          bubble.innerHTML = "<em class='text-stone-400'>Tiada respons. Cuba lagi.</em>";
        }
      } catch (err: any) {
        const cursor = msgContainer.querySelector(".chatbot-cursor");
        if (cursor) cursor.remove();
        bubble.innerHTML = `<span class="text-red-500">⚠️ ${err.message || "Ralat rangkaian. Cuba lagi sebentar."}</span>`;
      } finally {
        isLoading = false;
        sendBtn.disabled = !input.value.trim();
      }
    }

    /* ── Auto-resize textarea ── */
    function autoResize() {
      input.style.height = "auto";
      input.style.height = Math.min(input.scrollHeight, 96) + "px";
    }

    /* ── Event listeners ── */
    input.addEventListener("input", () => {
      sendBtn.disabled = !input.value.trim() || isLoading;
      autoResize();
    });

    input.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        if (input.value.trim() && !isLoading) sendMessage(input.value);
      }
    });

    sendBtn.addEventListener("click", () => {
      if (input.value.trim() && !isLoading) sendMessage(input.value);
    });

    // Suggested questions
    document.querySelectorAll(".chatbot-suggestion").forEach((btn) => {
      btn.addEventListener("click", () => {
        const text = btn.textContent?.trim() || "";
        if (text) sendMessage(text);
      });
    });
  })();
</script>
