---
// ChatBot.astro — floating AI chat widget for panduanhajiumrah
// v3: feedback, voice, analytics, multi-language
---

<button id="chatbot-fab" aria-label="Tanya Panduan Haji" class="fixed bottom-5 right-5 z-50 w-14 h-14 rounded-full bg-[#0d7377] text-white shadow-lg hover:bg-[#095e61] transition-all duration-200 flex items-center justify-center print:hidden">
  <svg id="chatbot-icon-open" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
  </svg>
  <svg id="chatbot-icon-close" class="w-7 h-7 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
  </svg>
  <span id="chatbot-badge" class="hidden absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">1</span>
</button>

<div id="chatbot-window" role="dialog" aria-label="Chatbot Panduan Haji" aria-modal="false" class="fixed bottom-24 right-5 z-50 w-[min(380px,calc(100vw-2rem))] h-[min(560px,calc(100vh-6rem))] bg-white dark:bg-[var(--color-surface)] border border-stone-200 dark:border-stone-700 rounded-2xl shadow-2xl flex flex-col overflow-hidden transition-all duration-300 origin-bottom-right print:hidden" style="display:none;opacity:0;transform:scale(0.9)">
  <div class="flex items-center justify-between px-4 py-3 bg-[#0d7377] text-white shrink-0">
    <div class="flex items-center gap-2">
      <span class="text-lg">🕌</span>
      <div>
        <p class="font-semibold text-sm leading-tight" data-i18n="title">Tanya Panduan Haji</p>
        <p class="text-[11px] opacity-80 leading-tight" data-i18n="subtitle">AI assistant · Bukan fatwa rasmi</p>
      </div>
    </div>
    <div class="flex items-center gap-1">
      <select id="chatbot-lang" class="text-[10px] bg-white/20 text-white rounded px-1 py-0.5 border-0 outline-none cursor-pointer"><option value="ms" class="text-[var(--color-ink)]">🇲🇾 BM</option><option value="en" class="text-[var(--color-ink)]">🇬🇧 EN</option><option value="ar" class="text-[var(--color-ink)]">🇸🇦 AR</option></select>
      <button id="chatbot-clear" aria-label="Padam sejarah" title="Padam sejarah" class="p-1 rounded hover:bg-white/20 transition">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      </button>
      <button id="chatbot-close" aria-label="Tutup" class="p-1 rounded hover:bg-white/20 transition">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </button>
    </div>
  </div>

  <!-- Disclaimer banner (first open) -->
  <div id="chatbot-disclaimer" class="hidden bg-amber-50 dark:bg-amber-900/30 border-b border-amber-200 dark:border-amber-700 px-4 py-2.5 text-xs text-amber-800 dark:text-amber-200 shrink-0">
    <p class="font-medium" data-i18n="disclaimer">⚠️ AI Assistant — Bukan fatwa rasmi</p>
    <p class="mt-0.5 opacity-80" data-i18n="disclaimerBody">Jawapan adalah panduan umum sahaja. Untuk keputusan agama, sila rujuk ustaz, mufti, atau JAKIM.</p>
    <button id="chatbot-dismiss-disclaimer" class="mt-1.5 px-3 py-1 bg-amber-200 dark:bg-amber-700 rounded text-amber-900 dark:text-amber-100 font-medium hover:bg-amber-300 dark:hover:bg-amber-600 transition" data-i18n="disclaimerBtn">Faham ✓</button>
  </div>

  <div id="chatbot-messages" class="flex-1 overflow-y-auto px-4 py-3 space-y-3 text-sm scroll-smooth">
    <div class="flex gap-2 items-start">
      <span class="text-base shrink-0 mt-0.5">🤖</span>
      <div id="chatbot-welcome" class="bg-stone-100 dark:bg-stone-800 rounded-xl rounded-tl-sm px-3 py-2 max-w-[85%] text-[var(--color-ink)] dark:text-stone-200 leading-relaxed">
        <p data-i18n="welcome">Assalamualaikum! 👋 Saya Panduan Haji AI.</p>
        <p class="mt-1" data-i18n="welcomeSub">Boleh tanya apa sahaja tentang haji &amp; umrah — rukun, tatacara, fiqh, persiapan.</p>
      </div>
    </div>
    <div id="chatbot-tools" class="pl-7">
      <p class="text-[10px] text-stone-400 dark:text-stone-500 mb-1.5 uppercase tracking-wider" data-i18n="tools">Alat Pantas</p>
      <div class="flex flex-wrap gap-1.5">
        <a href="/alat/kalkulator-dam/" class="chatbot-tool text-[11px] px-2.5 py-1 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition">💰 Kalkulator Dam</a>
        <a href="/alat/solat-musafir/" class="chatbot-tool text-[11px] px-2.5 py-1 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition">🕌 Solat Musafir</a>
        <a href="/alat/doa-harian/" class="chatbot-tool text-[11px] px-2.5 py-1 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition">📖 Doa Harian</a>
        <a href="/alat/wukuf-countdown/" class="chatbot-tool text-[11px] px-2.5 py-1 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition">⏰ Wukuf</a>
        <a href="/alat/checklist/" class="chatbot-tool text-[11px] px-2.5 py-1 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition">✅ Checklist</a>
      </div>
    </div>
    <div id="chatbot-suggestions" class="flex flex-wrap gap-2 pl-7">
      <button class="chatbot-suggestion text-xs px-3 py-1.5 rounded-full border border-[#0d7377] text-[#0d7377] dark:border-teal-400 dark:text-teal-400 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition whitespace-nowrap" data-i18n="faqApa">Apa rukun haji?</button>
      <button class="chatbot-suggestion text-xs px-3 py-1.5 rounded-full border border-[#0d7377] text-[#0d7377] dark:border-teal-400 dark:text-teal-400 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition whitespace-nowrap" data-i18n="faqKos">Berapa kos umrah?</button>
      <button class="chatbot-suggestion text-xs px-3 py-1.5 rounded-full border border-[#0d7377] text-[#0d7377] dark:border-teal-400 dark:text-teal-400 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition whitespace-nowrap" data-i18n="faqWanita">Bolehkah wanita tanpa mahram?</button>
      <button class="chatbot-suggestion text-xs px-3 py-1.5 rounded-full border border-[#0d7377] text-[#0d7377] dark:border-teal-400 dark:text-teal-400 hover:bg-[#0d7377] hover:text-white dark:hover:bg-teal-400 dark:hover:text-[var(--color-ink)] transition whitespace-nowrap" data-i18n="faqSolat">Bagaimana solat musafir?</button>
    </div>
  </div>

  <div class="shrink-0 border-t border-stone-200 dark:border-stone-700 px-3 py-2 bg-white dark:bg-[var(--color-surface)]">
    <div class="flex gap-2 items-end">
      <button id="chatbot-mic" aria-label="Suarakan" title="Suarakan" class="shrink-0 w-9 h-9 rounded-xl border border-stone-300 dark:border-stone-600 text-stone-400 dark:text-stone-500 flex items-center justify-center hover:bg-stone-100 dark:hover:bg-stone-700 transition"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg></button>
      <textarea id="chatbot-input" aria-label="Taip soalan anda" rows="1" placeholder="Taip soalan anda..." class="flex-1 resize-none rounded-xl border border-stone-300 dark:border-stone-600 bg-stone-50 dark:bg-stone-800 px-3 py-2 text-sm text-[var(--color-ink)] dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-[#0d7377] dark:focus:ring-teal-400 max-h-24 leading-relaxed"></textarea>
      <button id="chatbot-send" aria-label="Hantar" class="shrink-0 w-9 h-9 rounded-xl bg-[#0d7377] text-white flex items-center justify-center hover:bg-[#095e61] disabled:opacity-40 disabled:cursor-not-allowed transition" disabled>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>
    <p class="text-[10px] text-stone-400 dark:text-stone-500 mt-1 text-center" data-i18n="footer">AI assistant — rujuk ustaz untuk keputusan agama</p>
  </div>
</div>

<script>
(function(){
  var SK="phu-chatbot-history",DK="phu-chatbot-disclaimer",CD=2000,MX=20,EX=24;
  var fab=document.getElementById("chatbot-fab"),iO=document.getElementById("chatbot-icon-open"),iC=document.getElementById("chatbot-icon-close"),badge=document.getElementById("chatbot-badge");
  var win=document.getElementById("chatbot-window"),clsBtn=document.getElementById("chatbot-close"),disclaimer=document.getElementById("chatbot-disclaimer"),disBtn=document.getElementById("chatbot-dismiss-disclaimer");
  var mc=document.getElementById("chatbot-messages"),sug=document.getElementById("chatbot-suggestions"),toolsEl=document.getElementById("chatbot-tools");
  var inp=document.getElementById("chatbot-input"),snd=document.getElementById("chatbot-send"),clrBtn=document.getElementById("chatbot-clear");
  var open=false,load=false,lt=0;
  var msgs=[];
  var msgIdx=0;
  var langSel=document.getElementById("chatbot-lang"),micBtn=document.getElementById("chatbot-mic");
  var lang="ms";
  function track(ev,d){try{var a=JSON.parse(localStorage.getItem("phu-analytics")||"{}");if(!a.e)a.e=[];a.e.push({ev:ev,d:d,t:Date.now()});if(a.e.length>200)a.e=a.e.slice(-100);localStorage.setItem("phu-analytics",JSON.stringify(a))}catch(e){}}

  /* Language labels */
  var LL={ms:{title:"Tanya Panduan Haji",subtitle:"AI assistant · Bukan fatwa rasmi",disclaimer:"\u26a0\ufe0f AI Assistant \u2014 Bukan fatwa rasmi",disclaimerBody:"Jawapan adalah panduan umum sahaja. Untuk keputusan agama, sila rujuk ustaz, mufti, atau JAKIM.",disclaimerBtn:"Faham \u2713",welcome:"Assalamualaikum! \ud83d\udc4b Saya Panduan Haji AI.",welcomeSub:"Boleh tanya apa sahaja tentang haji & umrah \u2014 rukun, tatacara, fiqh, persiapan.",tools:"Alat Pantas",placeholder:"Taip soalan anda...",footer:"AI assistant \u2014 rujuk ustaz untuk keputusan agama",clearConfirm:"Padam semua sejarah chat?",faqApa:"Apa rukun haji?",faqKos:"Berapa kos umrah?",faqWanita:"Bolehkah wanita tanpa mahram?",faqSolat:"Bagaimana solat musafir?"},en:{title:"Ask Hajj Guide",subtitle:"AI assistant \u00b7 Not an official fatwa",disclaimer:"\u26a0\ufe0f AI Assistant \u2014 Not an official fatwa",disclaimerBody:"Answers are general guidance only. For religious rulings, please consult an imam, mufti, or religious authority.",disclaimerBtn:"Understood \u2713",welcome:"Assalamu Alaikum! \ud83d\udc4b I'm Hajj Guide AI.",welcomeSub:"Ask me anything about Hajj & Umrah \u2014 pillars, procedures, fiqh, preparation.",tools:"Quick Tools",placeholder:"Type your question...",footer:"AI assistant \u2014 consult an imam for religious rulings",clearConfirm:"Delete all chat history?",faqApa:"What are the pillars of Hajj?",faqKos:"How much does Umrah cost?",faqWanita:"Can women go without a mahram?",faqSolat:"How to pray while travelling?"},ar:{title:"\u0627\u0633\u0623\u0644 \u062f\u0644\u064a\u0644 \u0627\u0644\u062d\u062c",subtitle:"\u0645\u0633\u0627\u0639\u062f \u0630\u0643\u0627\u0621 \u00b7 \u0644\u064a\u0633 \u0641\u062a\u0648\u0649 \u0631\u0633\u0645\u064a\u0629",disclaimer:"\u26a0\ufe0f \u0645\u0633\u0627\u0639\u062f \u0630\u0643\u0627\u0621 \u2014 \u0644\u064a\u0633 \u0641\u062a\u0648\u0649 \u0631\u0633\u0645\u064a\u0629",disclaimerBody:"\u0627\u0644\u0625\u062c\u0627\u0628\u0627\u062a \u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0639\u0627\u0645\u0629 \u0641\u0642\u0637. \u0644\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u062f\u064a\u0646\u064a\u0629\u060c \u064a\u0631\u062c\u0649 \u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0639\u0627\u0644\u0645 \u0623\u0648 \u0645\u0641\u062a\u064a.",disclaimerBtn:"\u0641\u0647\u0645\u062a \u2713",welcome:"\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u064a\u0643\u0645! \ud83d\udc4b \u0623\u0646\u0627 \u062f\u0644\u064a\u0644 \u0627\u0644\u062d\u062c \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a.",welcomeSub:"\u0627\u0633\u0623\u0644\u0646\u064a \u0623\u064a \u0634\u064a\u0621 \u0639\u0646 \u0627\u0644\u062d\u062c \u0648\u0627\u0644\u0639\u0645\u0631\u0629 \u2014 \u0627\u0644\u0623\u0631\u0643\u0627\u0646\u060c \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a\u060c \u0627\u0644\u0641\u0642\u0647\u060c \u0627\u0644\u062a\u062d\u0636\u064a\u0631.",tools:"\u0623\u062f\u0648\u0627\u062a \u0633\u0631\u064a\u0639\u0629",placeholder:"\u0627\u0643\u062a\u0628 \u0633\u0624\u0627\u0644\u0643...",footer:"\u0645\u0633\u0627\u0639\u062f \u0630\u0643\u0627\u0621 \u2014 \u0631\u0627\u062c\u0639 \u0639\u0627\u0644\u0645\u0627\u064b \u0644\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u062f\u064a\u0646\u064a\u0629",clearConfirm:"\u062d\u0630\u0641 \u062c\u0645\u064a\u0639 \u0633\u062c\u0644 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629\u061f",faqApa:"\u0645\u0627 \u0647\u064a \u0623\u0631\u0643\u0627\u0646 \u0627\u0644\u062d\u062c\u061f",faqKos:"\u0643\u0645 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0639\u0645\u0631\u0629\u061f",faqWanita:"\u0647\u0644 \u062a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0645\u0631\u0623\u0629 \u0628\u062f\u0648\u0646 \u0645\u062d\u0631\u0645\u061f",faqSolat:"\u0643\u064a\u0641 \u062a\u0635\u0644\u064a \u0627\u0644\u0645\u0633\u0627\u0641\u0631\u061f"}};
  function getL(){return LL[lang]||LL.ms}
  function updateUI(){
    var l=getL();
    win.querySelectorAll("[data-i18n]").forEach(function(el){
      var k=el.getAttribute("data-i18n");
      if(l[k])el.textContent=l[k];
    });
    inp.placeholder=l.placeholder||"";
    inp.setAttribute("aria-label",l.placeholder||"");
    snd.setAttribute("aria-label",l.title||"");
  }

  function save(){try{localStorage.setItem(SK,JSON.stringify({messages:msgs.slice(-MX),t:Date.now(),lang:lang}))}catch(e){}}
  function loadH(){try{var r=localStorage.getItem(SK);if(!r)return[];var d=JSON.parse(r);if((Date.now()-(d.t||0))/(36e5*EX)>1){localStorage.removeItem(SK);return[]}if(d.lang){lang=d.lang;langSel.value=lang}return Array.isArray(d.messages)?d.messages:[]}catch(e){return[]}}
  function clearH(){localStorage.removeItem(SK);msgs.length=0;mc.innerHTML="";var l=getL();var w=document.createElement("div");w.className="flex gap-2 items-start";w.innerHTML='<span class="text-base shrink-0 mt-0.5">🤖</span><div id="chatbot-welcome" class="bg-stone-100 dark:bg-stone-800 rounded-xl rounded-tl-sm px-3 py-2 max-w-[85%] text-[var(--color-ink)] dark:text-stone-200 leading-relaxed"><p data-i18n="welcome">'+l.welcome+'</p><p class="mt-1" data-i18n="welcomeSub">'+l.welcomeSub+'</p></div>';mc.appendChild(w);if(toolsEl)toolsEl.style.display="";if(sug)sug.style.display=""}

  if(!localStorage.getItem(DK))disclaimer.classList.remove("hidden");
  disBtn.addEventListener("click",function(){disclaimer.classList.add("hidden");localStorage.setItem(DK,"1")});
  langSel.addEventListener("change",function(){lang=langSel.value;save();track("lang",{l:lang});updateUI()});

  function toggle(o){open=o!==undefined?o:!open;if(open){win.style.display="flex";requestAnimationFrame(function(){win.style.opacity="1";win.style.transform="scale(1)"});iO.classList.add("hidden");iC.classList.remove("hidden");badge.classList.add("hidden");inp.focus()}else{win.style.opacity="0";win.style.transform="scale(0.9)";setTimeout(function(){win.style.display="none"},250);iO.classList.remove("hidden");iC.classList.add("hidden")}}
  fab.addEventListener("click",function(){toggle()});clsBtn.addEventListener("click",function(){toggle(false)});
  clrBtn.addEventListener("click",function(){siteConfirmDanger(getL().clearConfirm).then(function(ok){if(ok)clearH()})});

  function renderMd(t){
    var h=t.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    h=h.replace(/^### (.+)$/gm,'<p class="font-bold text-sm mt-2 mb-1">$1</p>');
    h=h.replace(/^## (.+)$/gm,'<p class="font-bold mt-2 mb-1">$1</p>');
    h=h.replace(/^&gt; (.+)$/gm,'<blockquote class="border-l-2 border-[#0d7377] dark:border-teal-400 pl-2 italic opacity-80 my-1">$1</blockquote>');
    h=h.replace(/^---+$/gm,'<hr class="border-stone-200 dark:border-stone-700 my-2"/>');
    h=h.replace(/^(\d\ufe0f\u20e3|[0-9]+\.?)\s*(.+)$/gm,'<div class="flex gap-1.5 my-0.5"><span class="shrink-0">$1</span><span>$2</span></div>');
    h=h.replace(/^[-\u2022]\s+(.+)$/gm,'<div class="flex gap-1.5 my-0.5"><span class="shrink-0">\u2022</span><span>$1</span></div>');
    h=h.replace(/\[([^\]]+)\]\(([^)]+)\)/g,'<a href="$2" class="underline text-[#0d7377] dark:text-teal-400 hover:opacity-80" target="_blank" rel="noopener">$1</a>');
    h=h.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>").replace(/\*(.+?)\*/g,"<em>$1</em>");
    h=h.replace(/`([^`]+)`/g,'<code class="bg-stone-200 dark:bg-stone-700 px-1 rounded text-xs">$1</code>');
    h=h.replace(/\n(?!<)/g,"<br/>");return h}

  function addTyping(){var w=document.createElement("div");w.className="flex gap-2 items-start chatbot-typing";w.innerHTML='<span class="text-base shrink-0 mt-0.5">🤖</span><div class="bg-stone-100 dark:bg-stone-800 rounded-xl rounded-tl-sm px-3 py-2 text-[var(--color-ink)] dark:text-stone-200"><div class="flex gap-1 items-center"><span class="w-2 h-2 bg-[#0d7377] dark:bg-teal-400 rounded-full animate-bounce" style="animation-delay:0ms"></span><span class="w-2 h-2 bg-[#0d7377] dark:bg-teal-400 rounded-full animate-bounce" style="animation-delay:150ms"></span><span class="w-2 h-2 bg-[#0d7377] dark:bg-teal-400 rounded-full animate-bounce" style="animation-delay:300ms"></span></div></div>';mc.appendChild(w);mc.scrollTop=mc.scrollHeight;return w}
  function rmTyping(){var t=mc.querySelector(".chatbot-typing");if(t)t.remove()}
  function addFeedback(bubble,idx){var fw=document.createElement("div");fw.className="flex gap-1 mt-1 pl-9";var u=document.createElement("button");u.className="text-xs px-2 py-0.5 rounded hover:bg-stone-200 dark:hover:bg-stone-700 transition opacity-50 hover:opacity-100";u.textContent="\ud83d\udc4d";u.title="Baik";var d=document.createElement("button");d.className="text-xs px-2 py-0.5 rounded hover:bg-stone-200 dark:hover:bg-stone-700 transition opacity-50 hover:opacity-100";d.textContent="\ud83d\udc4e";d.title="Tak tepat";u.addEventListener("click",function(){u.style.opacity="1";d.style.opacity="0.3";u.style.fontWeight="bold";track("feedback",{i:idx,r:"up"})});d.addEventListener("click",function(){d.style.opacity="1";u.style.opacity="0.3";d.style.fontWeight="bold";track("feedback",{i:idx,r:"down"})});fw.appendChild(u);fw.appendChild(d);mc.appendChild(fw)}

  function addMsg(role,content,streaming){
    streaming=streaming||false;
    var w=document.createElement("div");w.className="flex gap-2 items-start "+(role==="user"?"justify-end":"");
    var b=document.createElement("div");b.className=role==="user"?"bg-[#0d7377] text-white rounded-xl rounded-tr-sm px-3 py-2 max-w-[85%] leading-relaxed":"bg-stone-100 dark:bg-stone-800 text-[var(--color-ink)] dark:text-stone-200 rounded-xl rounded-tl-sm px-3 py-2 max-w-[85%] leading-relaxed chatbot-bot-bubble";
    if(role==="assistant"){var e=document.createElement("span");e.className="text-base shrink-0 mt-0.5";e.textContent="🤖";w.appendChild(e)}
    b.innerHTML=renderMd(content);w.appendChild(b);
    if(role==="user"){var e2=document.createElement("span");e2.className="text-base shrink-0 mt-0.5";e2.textContent="👤";w.appendChild(e2)}
    var ec=mc.querySelector(".chatbot-cursor");if(ec)ec.remove();
    mc.appendChild(w);
    if(streaming){var c=document.createElement("span");c.className="chatbot-cursor inline-block w-1.5 h-4 bg-[#0d7377] dark:bg-teal-400 animate-pulse ml-0.5 align-middle";b.appendChild(c)}
    mc.scrollTop=mc.scrollHeight;return b}

  function sendMessage(text){
    if(!text.trim()||load)return;
    var now=Date.now();if(now-lt<CD){var w=Math.ceil((CD-(now-lt))/1000);addMsg("assistant","\u23f3 Tunggu "+w+"s sebelum hantar mesej.");return}
    lt=now;
    var ut=text.trim();inp.value="";autoR();snd.disabled=true;
    if(sug)sug.style.display="none";if(toolsEl)toolsEl.style.display="none";
    msgs.push({role:"user",content:ut});addMsg("user",ut);save();track("q",{t:ut.substring(0,80),l:lang});msgIdx=msgIdx||0;msgIdx++;
    load=true;var typing=addTyping();
    fetch("/api/chat/",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({messages:msgs,pageUrl:window.location.pathname,lang:lang})})
    .then(function(r){
      rmTyping();
      if(!r.ok)return r.json().then(function(e){
        if(e.choices&&e.choices[0]&&e.choices[0].message&&e.choices[0].message.content){var b=addMsg("assistant",e.choices[0].message.content);addFeedback(b,msgIdx);msgs.push({role:"assistant",content:e.choices[0].message.content});save();return}
        throw new Error(e.detail||"HTTP "+r.status)});
      var ct=r.headers.get("content-type")||"";
      if(ct.indexOf("application/json")>=0)return r.json().then(function(d){var fc=(d.choices&&d.choices[0]&&d.choices[0].message&&d.choices[0].message.content)||d.detail||"Maaf, cuba lagi.";var b2=addMsg("assistant",fc);addFeedback(b2,msgIdx);msgs.push({role:"assistant",content:fc});save()});
      var bubble=addMsg("assistant","",true);var reader=r.body.getReader();var dec=new TextDecoder();var full="";var buf="";
      function pump(){return reader.read().then(function(result){
        if(result.done){var cur=mc.querySelector(".chatbot-cursor");if(cur)cur.remove();if(full){msgs.push({role:"assistant",content:full});save();addFeedback(bubble,msgIdx);track("resp",{l:full.length})}else bubble.innerHTML="<em class=\"text-stone-400\">Tiada respons.</em>";return}
        buf+=dec.decode(result.value,{stream:true});var lines=buf.split("\n");buf=lines.pop()||"";
        for(var i=0;i<lines.length;i++){var tr=lines[i].trim();if(!tr||tr.indexOf("data:")!==0)continue;var d=tr.slice(5).trim();if(d==="[DONE]")continue;
          try{var p=JSON.parse(d);var dl=p.choices&&p.choices[0]&&p.choices[0].delta&&p.choices[0].delta.content;if(dl){full+=dl;bubble.innerHTML=renderMd(full);var cur2=document.createElement("span");cur2.className="chatbot-cursor inline-block w-1.5 h-4 bg-[#0d7377] dark:bg-teal-400 animate-pulse ml-0.5 align-middle";bubble.appendChild(cur2);mc.scrollTop=mc.scrollHeight}}catch(e){}}
        return pump()})}
      return pump()})
    .catch(function(err){
      rmTyping();var cur=mc.querySelector(".chatbot-cursor");if(cur)cur.remove();
      var lt2=ut.toLowerCase();var fb="";
      if(lt2.indexOf("rukun haji")>=0)fb="Rukun Haji ada 5:\n1\ufe0f\u20e3 Ihram\n2\ufe0f\u20e3 Wukuf di Arafah\n3\ufe0f\u20e3 Tawaf\n4\ufe0f\u20e3 Saie\n5\ufe0f\u20e3 Bercukur\n\n📖 [Baca selengkapnya](/panduan/haji/rukun-haji/)";
      else if(lt2.indexOf("umrah")>=0)fb="Rukun Umrah ada 5:\n1\ufe0f\u20e3 Ihram dari miqat\n2\ufe0f\u20e3 Tawaf 7 pusingan\n3\ufe0f\u20e3 Saie 7 kali\n4\ufe0f\u20e3 Bercukur\n5\ufe0f\u20e3 Tertib\n\n📖 [Baca](/panduan/umrah/tatacara-asas-umrah/)";
      else if(lt2.indexOf("solat")>=0||lt2.indexOf("musafir")>=0||lt2.indexOf("qasar")>=0)fb="Solat musafir: jarak >80km boleh qasar & jamak.\n\n🔧 [Kalkulator Solat Musafir](/alat/solat-musafir/)";
      else if(lt2.indexOf("kos")>=0||lt2.indexOf("harga")>=0)fb="Kos umrah: RM5,000\u2013RM15,000 bergantung pakej.\n\n🔧 [Kalkulator Kos](/alat/kalkulator-kos/)";
      if(fb){var b3=addMsg("assistant",fb+"\n\n<small class=\"opacity-60\">(Jawapan offline \u2014 AI sedang rehat)</small>");msgs.push({role:"assistant",content:fb});save();addFeedback(b3,msgIdx)}
      else addMsg("assistant","\u26a0\ufe0f "+(err.message||"Ralat rangkaian.")+"\n\n<small class=\"opacity-60\">Tip: Cuba tanya tentang rukun haji, umrah, atau solat musafir.</small>")
    })
    .then(function(){load=false;snd.disabled=!inp.value.trim()})}

  function autoR(){inp.style.height="auto";inp.style.height=Math.min(inp.scrollHeight,96)+"px"}
  inp.addEventListener("input",function(){snd.disabled=!inp.value.trim()||load;autoR()});
  inp.addEventListener("keydown",function(e){if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();if(inp.value.trim()&&!load)sendMessage(inp.value)}});
  snd.addEventListener("click",function(){if(inp.value.trim()&&!load)sendMessage(inp.value)});
  document.querySelectorAll(".chatbot-suggestion").forEach(function(b){b.addEventListener("click",function(){var t=b.textContent.trim();if(t)sendMessage(t)})});
  document.querySelectorAll(".chatbot-tool").forEach(function(a){a.addEventListener("click",function(e){e.preventDefault();var n=a.textContent.trim();if(n)sendMessage("Bagaimana guna "+n+"?")})});

  // Voice recognition
  var recog=null,listening=false;
  if("webkitSpeechRecognition" in window||"SpeechRecognition" in window){
    var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    recog=new SR();recog.continuous=false;recog.interimResults=true;
    recog.lang="ms-MY";
    recog.onresult=function(e){var tr="";for(var i=0;i<e.results.length;i++)tr+=e.results[i][0].transcript;inp.value=tr;autoR();snd.disabled=!tr.trim()};
    recog.onend=function(){listening=false;micBtn.classList.remove("bg-red-100","dark:bg-red-900","text-red-500");micBtn.classList.add("text-stone-400","dark:text-stone-500")};
    recog.onerror=function(){listening=false;micBtn.classList.remove("bg-red-100","dark:bg-red-900","text-red-500");micBtn.classList.add("text-stone-400","dark:text-stone-500")};
    micBtn.addEventListener("click",function(){
      if(!recog)return;if(listening){recog.stop();return}
      recog.lang=lang==="ms"?"ms-MY":lang==="ar"?"ar-SA":"en-US";
      listening=true;micBtn.classList.add("bg-red-100","dark:bg-red-900","text-red-500");micBtn.classList.remove("text-stone-400","dark:text-stone-500");
      recog.start()});
  }else{micBtn.style.display="none"}

  var loaded=false;var saved=loadH();updateUI();if(saved.length>0){for(var i=0;i<saved.length;i++)addMsg(saved[i].role,saved[i].content);for(var j=0;j<saved.length;j++)msgs.push(saved[j]);if(sug)sug.style.display="none";if(toolsEl)toolsEl.style.display="none"}

  loaded=true;
  var _obs=new MutationObserver(function(){var _b=document.getElementById("chatbot-badge");if(loaded&&!open&&_b&&msgs.length>0&&msgs[msgs.length-1].role==="assistant"){_b.classList.remove("hidden");_b.classList.add("flex")}});_obs.observe(mc,{childList:true});
})();
</script>