---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShareButtons from "../../../components/ShareButtons.astro";
import TableOfContents from "../../../components/TableOfContents.astro";

export async function getStaticPaths() {
  const guides = await getCollection("guide", ({ data }) => !data.draft);
  return guides.map((entry) => ({
    params: { section: entry.data.section, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const author = await getEntry(entry.data.author);
const siteUrl = Astro.site ?? new URL("https://panduanhajiumrah.vercel.app");
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
  author: {
    "@type": "Person",
    name: author?.data.name ?? "Aiman",
  },
  publisher: {
    "@type": "Organization",
    name: "Panduan Haji & Umrah",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", siteUrl).href,
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  inLanguage: "ms-MY",
  isAccessibleForFree: true,
  citation: entry.data.sources.map((s) => ({
    "@type": "CreativeWork",
    name: s.label,
    url: s.url,
  })),
};

const sectionLabels: Record<string, string> = {
  persiapan: "Persiapan",
  "ihram-miqat": "Ihram & Miqat",
  umrah: "Umrah",
  haji: "Haji",
  tempat: "Tempat Penting",
  "doa-zikir": "Doa & Zikir",
  "hukum-khas": "Hukum Khas",
  selepas: "Selepas Pulang",
};
const sectionLabel = sectionLabels[entry.data.section] ?? entry.data.section;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Laman Utama", item: siteUrl.href },
    { "@type": "ListItem", position: 2, name: "Panduan", item: new URL("/panduan/", siteUrl).href },
    { "@type": "ListItem", position: 3, name: sectionLabel, item: new URL(`/panduan/${entry.data.section}/`, siteUrl).href },
    { "@type": "ListItem", position: 4, name: entry.data.title, item: pageUrl },
  ],
};

// Related: same-section guides (excl self), in order. Pick 3 closest by order.
const sectionGuides = (await getCollection("guide", ({ data }) => !data.draft))
  .filter((g) => g.data.section === entry.data.section && g.id !== entry.id)
  .sort((a, b) => Math.abs(a.data.order - entry.data.order) - Math.abs(b.data.order - entry.data.order))
  .slice(0, 3);

// Related: articles tagged with this guide via relatedGuides[]
const allArticles = await getCollection("article", ({ data }) => !data.draft);
const relatedArticles = allArticles
  .filter((a) =>
    Array.isArray(a.data.relatedGuides) &&
    a.data.relatedGuides.some((ref) => ref.id === entry.id)
  )
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  {/* Visible breadcrumb */}
  <nav class="max-w-5xl mx-auto px-4 pt-6 text-sm text-[var(--color-stone-warm)]" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-x-1 gap-y-1">
      <li><a href="/" class="hover:text-[var(--color-saffron)] hover:underline">Laman Utama</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/panduan/" class="hover:text-[var(--color-saffron)] hover:underline">Panduan</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={`/panduan/${entry.data.section}/`} class="hover:text-[var(--color-saffron)] hover:underline">
          {sectionLabel}
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li class="text-[var(--color-ink)] truncate max-w-[16rem]" aria-current="page">{entry.data.title}</li>
    </ol>
  </nav>

  <div class="toc-container">
  <TableOfContents />
  <article class="prose-haji">
    <p class="text-sm text-stone-500 uppercase tracking-wide mb-2">
      Panduan / {entry.data.section.replace("-", " ")}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="text-lg text-stone-600 mb-6">{entry.data.description}</p>

    {entry.data.factChecked && entry.data.factCheckedAt && (
      <div class="flex items-center gap-2 mb-6 px-3 py-2 rounded-md bg-emerald-50 border border-emerald-200 text-sm text-emerald-800 w-fit">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 12l2 2 4-4"></path>
          <circle cx="12" cy="12" r="10"></circle>
        </svg>
        <span class="font-medium">
          Disemak fakta · {entry.data.factCheckedAt.toLocaleDateString("ms-MY", {
            year: "numeric", month: "short", day: "numeric",
          })}
        </span>
        <span class="text-emerald-600">·</span>
        <a href="/tentang/#semakan-fakta" class="text-emerald-700 hover:text-emerald-900 underline decoration-emerald-300 underline-offset-2">
          Bagaimana
        </a>
      </div>
    )}

    <p class="text-sm text-stone-500 mb-8">
      Diterbitkan {entry.data.publishedAt.toLocaleDateString("ms-MY", {
        year: "numeric", month: "long", day: "numeric",
      })}
      {entry.data.updatedAt && ` · Dikemaskini ${entry.data.updatedAt.toLocaleDateString("ms-MY", {
        year: "numeric", month: "long", day: "numeric",
      })}`}
      {entry.data.readingMinutes && ` · ${entry.data.readingMinutes} min bacaan`}
    </p>

    <ShareButtons title={entry.data.title} url={pageUrl} />

    <Content />

    <div class="source-list">
      <h3>Rujukan</h3>
      <ol class="list-decimal pl-6 space-y-1">
        {entry.data.sources.map((src) => (
          <li>
            <a href={src.url} target="_blank" rel="noopener noreferrer">{src.label}</a>
            <span class="text-stone-500 text-xs">
              {" "}— diakses {src.accessedAt.toLocaleDateString("ms-MY")}
            </span>
            {src.excerpt && (
              <p class="text-stone-600 text-xs italic ml-4 mt-1">"{src.excerpt}"</p>
            )}
          </li>
        ))}
      </ol>
    </div>
  </article>
  </div>

  {/* Related articles citing this guide */}
  {relatedArticles.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 mt-16">
      <div class="border-t border-[var(--color-rule)] pt-10">
        <p class="badge badge-teal mb-4">Artikel Berkaitan</p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {relatedArticles.map((rel) => (
            <li>
              <a
                href={`/artikel/${rel.data.category}/${rel.id}/`}
                class="block p-5 border border-[var(--color-rule)] rounded-lg hover:border-[var(--color-saffron)] transition-colors"
              >
                <p class="text-xs uppercase tracking-[0.12em] text-[var(--color-stone-warm)] mb-1">
                  Artikel / {rel.data.category}
                </p>
                <p class="font-semibold text-[var(--color-ink)] mb-1" style="font-family: var(--font-serif);">
                  {rel.data.title}
                </p>
                <p class="text-sm text-[var(--color-stone-warm)] line-clamp-2">{rel.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Same-section guides */}
  {sectionGuides.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 mt-12 pb-16">
      <div class="border-t border-[var(--color-rule)] pt-10">
        <div class="flex items-baseline justify-between mb-6 gap-4 flex-wrap">
          <p class="badge badge-teal">Lagi dalam {sectionLabel}</p>
          <a href={`/panduan/${entry.data.section}/`} class="text-sm font-semibold text-[var(--color-teal-deep)] hover:text-[var(--color-saffron)] uppercase tracking-[0.12em]">
            Semua →
          </a>
        </div>
        <ul class="space-y-4">
          {sectionGuides.map((g) => (
            <li>
              <a
                href={`/panduan/${g.data.section}/${g.id}/`}
                class="block py-3 border-b border-[var(--color-rule)] hover:bg-stone-50 transition-colors -mx-2 px-2 rounded"
              >
                <h3 class="font-semibold text-[var(--color-ink)] mb-1" style="font-family: var(--font-serif);">
                  {g.data.title}
                </h3>
                <p class="text-sm text-[var(--color-stone-warm)] line-clamp-2">{g.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
