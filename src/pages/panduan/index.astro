---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const guideEntries = await getCollection("guide", ({ data }) => !data.draft);

const sectionOrder = [
  "persiapan", "ihram-miqat", "umrah", "haji",
  "tempat", "doa-zikir", "hukum-khas", "selepas",
] as const;

const sectionLabels: Record<typeof sectionOrder[number], string> = {
  persiapan: "Persiapan",
  "ihram-miqat": "Ihram & Miqat",
  umrah: "Umrah",
  haji: "Haji",
  tempat: "Tempat Penting",
  "doa-zikir": "Doa & Zikir",
  "hukum-khas": "Hukum Khas",
  selepas: "Selepas Pulang",
};

const sectionDescriptions: Record<typeof sectionOrder[number], string> = {
  persiapan: "Dokumen perjalanan, kewangan, kesihatan, dan ilmu asas sebelum berangkat.",
  "ihram-miqat": "Niat ihram, miqat, larangan, dan adab semasa berihram.",
  umrah: "Rukun, wajib, dan sunat umrah dari A ke Z.",
  haji: "Jenis haji, rukun, wajib, dan sunat haji.",
  tempat: "Mekah, Madinah, Mina, Arafah, Muzdalifah — peta dan kepentingan.",
  "doa-zikir": "Doa harian, talbiyah, dan zikir-zikir mathur.",
  "hukum-khas": "Wanita haid, sakit, lansia, OKU — panduan khusus.",
  selepas: "Adab pulang, mempertahankan haji mabrur.",
};

const groups = sectionOrder.map((section) => ({
  section,
  label: sectionLabels[section],
  description: sectionDescriptions[section],
  entries: guideEntries
    .filter((e) => e.data.section === section)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<BaseLayout
  title="Panduan A-Z Haji & Umrah"
  description="Panduan lengkap haji dan umrah disusun mengikut tahap perjalanan: persiapan, ihram, umrah, haji, hingga selepas pulang."
>
  <section class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-bold text-emerald-900 mb-4">Panduan A-Z</h1>
    <p class="text-lg text-stone-700 mb-8">
      Rujukan disusun mengikut tahap perjalanan jemaah, dari persiapan hingga
      selepas pulang. Setiap bab disemak fakta terhadap sumber rasmi.
    </p>

    <div class="space-y-8">
      {groups.map((group) => (
        <section>
          <h2 class="text-2xl font-semibold text-emerald-800 mb-1">{group.label}</h2>
          <p class="text-stone-600 mb-3">{group.description}</p>
          {group.entries.length > 0 ? (
            <ul class="space-y-1 pl-4 border-l-2 border-emerald-100">
              {group.entries.map((entry) => (
                <li>
                  <a
                    href={`/panduan/${entry.data.section}/${entry.id}`}
                    class="text-emerald-700 hover:text-emerald-900 hover:underline"
                  >
                    {entry.data.title}
                  </a>
                  <span class="text-stone-500 text-sm">
                    {" "}— {entry.data.description.slice(0, 80)}{entry.data.description.length > 80 ? "..." : ""}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-stone-400 italic pl-4">Bab belum diterbitkan.</p>
          )}
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
