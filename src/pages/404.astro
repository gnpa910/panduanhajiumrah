---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Halaman Tidak Dijumpai"
  description="Halaman yang anda cari tidak wujud atau telah dialihkan. Layari halaman utama atau direktori panduan untuk mencari kandungan yang anda perlukan."
>
  <section class="max-w-3xl mx-auto px-4 py-24 text-center">
    <p class="text-sm uppercase tracking-wide text-[var(--color-stone-warm)] mb-4">
      Ralat 404
    </p>
    <h1 class="text-4xl md:text-5xl font-semibold text-[var(--color-ink)] mb-4"
        style="font-family: var(--font-serif);">
      Halaman tidak dijumpai
    </h1>
    <p class="text-lg text-[var(--color-stone-warm)] mb-10 leading-relaxed">
      Mungkin URL salah ditaip, atau halaman telah dialihkan. Cuba mula
      semula dari salah satu pintu masuk berikut.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-2xl mx-auto">
      <a
        href="/"
        class="block p-6 border border-[var(--color-rule)] rounded-lg hover:border-[var(--color-saffron)] transition-colors"
      >
        <p class="font-semibold text-[var(--color-ink)] mb-1">Laman utama</p>
        <p class="text-sm text-[var(--color-stone-warm)]">
          Topik pilihan dan pengenalan
        </p>
      </a>
      <a
        href="/panduan/"
        class="block p-6 border border-[var(--color-rule)] rounded-lg hover:border-[var(--color-saffron)] transition-colors"
      >
        <p class="font-semibold text-[var(--color-ink)] mb-1">Panduan A–Z</p>
        <p class="text-sm text-[var(--color-stone-warm)]">
          Senarai penuh panduan
        </p>
      </a>
      <a
        href="/artikel/"
        class="block p-6 border border-[var(--color-rule)] rounded-lg hover:border-[var(--color-saffron)] transition-colors"
      >
        <p class="font-semibold text-[var(--color-ink)] mb-1">Artikel</p>
        <p class="text-sm text-[var(--color-stone-warm)]">
          Persoalan, berita, muzakarah
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
