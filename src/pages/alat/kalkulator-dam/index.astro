        ],
        amount: "RM810 (penuh) atau lebih kecil ikut bilangan",
        sources: [
          ["Mufti WP — Bayan Siri 29: Melontar Jamratul Kubra", "https://muftiwp.gov.my/ms/artikel/bayan-li-al-haj/690-bayan-li-al-haj-siri-ke-29-masa-untuk-melontar-jamratul-kubra-dan-amalan-sunat-ketika-melontar"],
