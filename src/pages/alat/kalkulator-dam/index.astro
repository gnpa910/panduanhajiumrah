      },
      "tinggal-niat-miqat": {
        category: "Tinggal Wajib Haji/Umrah",
        type: "Dam Tartib & Taqdir",
        headline: "Lalu miqat tanpa berihram",
        explanation:
          "Wajib berniat ihram di miqat. Lalu tanpa berihram dan terus ke Mekah = dam tartib.",
        options: [
