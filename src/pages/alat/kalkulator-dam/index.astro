        options: [
          "Wajib turutan:",
          "1️⃣ Sembelih seekor unta, atau",
          "2️⃣ Jika tidak mampu: seekor lembu, atau",
          "3️⃣ Tujuh ekor kambing, atau",
          "4️⃣ Sedekah/puasa setara nilai unta",
          "+ Wajib qadha haji tahun depan",
        ],
        amount: "Bergantung pasaran — rujuk pegawai TH/Mufti segera",
        sources: [
          ["Surah al-Baqarah 2:197", "https://quran.com/2/197"],
        ],
      },
    };

    const select = document.getElementById("dam-type");
    const result = document.getElementById("dam-result");
    const pill = document.getElementById("dam-category-pill");
    const typeLabel = document.getElementById("dam-type-label");
    const headline = document.getElementById("dam-headline");
    const explanation = document.getElementById("dam-explanation");
    const optionsEl = document.getElementById("dam-options");
    const amount = document.getElementById("dam-amount");
    const sourcesEl = document.getElementById("dam-sources");

    select.addEventListener("change", (e) => {
      const key = e.target.value;
      if (!key || !DAM_DATA[key]) {
        result.classList.add("hidden");
        return;
      }
      const d = DAM_DATA[key];
      pill.textContent = d.category;
      typeLabel.textContent = d.type;
      headline.textContent = d.headline;
      explanation.textContent = d.explanation;

      optionsEl.innerHTML = d.options
        .map(
          (o) =>
            `<div class="flex items-start gap-2 text-[var(--color-ink)]"><span>${o}</span></div>`
        )
        .join("");

      amount.innerHTML = `💰 <span class="text-[var(--color-teal)]">Anggaran:</span> ${d.amount}`;

      sourcesEl.innerHTML = d.sources
        .map(
          ([label, url]) =>
            `<li><a href="${url}" rel="noopener" class="text-[var(--color-teal)] underline">${label}</a></li>`
        )
        .join("");

      result.classList.remove("hidden");
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>

