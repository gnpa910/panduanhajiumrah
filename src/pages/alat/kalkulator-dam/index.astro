---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const siteUrl = Astro.site ?? new URL("https://panduanhajiumrah.vercel.app");
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Laman Utama", item: siteUrl.href },
    { "@type": "ListItem", position: 2, name: "Alat", item: new URL("/alat/", siteUrl).href },
    { "@type": "ListItem", position: 3, name: "Kalkulator Dam", item: pageUrl },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Kalkulator Dam Haji & Umrah",
  description:
    "Kira jenis dam, kategori (takhyir/tartib), dan kadar wajib bagi pelanggaran ihram atau dam tamattu — berdasarkan fatwa Mufti WP dan kadar ADAHI semasa.",
  applicationCategory: "ReligionApplication",
  operatingSystem: "Web",
  inLanguage: "ms-MY",
  isAccessibleForFree: true,
  url: pageUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "MYR" },
};
---

<BaseLayout
  title="Kalkulator Dam Haji & Umrah"
  description="Kira dam wajib untuk pelanggaran ihram, dam tamattu', atau fidyah — dengan kadar ADAHI 2026 (RM810/kibas) dan rujukan fatwa Mufti Wilayah Persekutuan."
  jsonLd={[breadcrumbSchema, webAppSchema]}
>
  <section class="max-w-4xl mx-auto px-4 py-10">
    {/* breadcrumb */}
    <nav class="text-sm text-[var(--color-stone-warm)] mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--color-teal)]">Laman Utama</a>
      <span class="mx-2">›</span>
      <a href="/alat/" class="hover:text-[var(--color-teal)]">Alat</a>
      <span class="mx-2">›</span>
      <span class="text-[var(--color-ink)]">Kalkulator Dam</span>
    </nav>

    <header class="mb-8">
      <p class="badge badge-teal mb-4">Alat Interaktif · Berasaskan Fatwa</p>
      <h1
        class="text-4xl md:text-5xl font-semibold text-[var(--color-ink)] mb-4"
        style="font-family: var(--font-serif);"
      >
        Kalkulator Dam
      </h1>
      <p class="text-lg text-[var(--color-ink)] max-w-2xl">
        Pilih jenis dam atau pelanggaran ihram, kalkulator akan tunjukkan
        kategori, pilihan bayaran, dan kadar wajar mengikut fatwa Mufti
        Wilayah Persekutuan dan kadar ADAHI semasa.
      </p>
    </header>

    {/* ─────── INPUT ─────── */}
    <div
      class="bg-[var(--color-surface)] border border-[var(--color-rule)] rounded-lg p-6 md:p-8 mb-6 shadow-sm"
    >
      <label
        for="dam-type"
        class="block text-sm font-semibold text-[var(--color-ink)] mb-2"
      >
        Pilih situasi
      </label>
      <select
        id="dam-type"
        class="w-full px-4 py-3 border border-[var(--color-rule)] rounded-md text-base bg-[var(--color-surface)] focus:border-[var(--color-teal)] focus:outline-none focus:ring-2 focus:ring-[var(--color-teal)]/30"
      >
        <option value="">— Pilih situasi anda —</option>
        <optgroup label="Dam Wajib (Tamattu/Qiran)">
          <option value="tamattu">Dam Tamattu' / Qiran (gabung umrah + haji)</option>
        </optgroup>
        <optgroup label="Pelanggaran Itlaf (kerosakan)">
          <option value="cukur-rambut">Mencukur 3 helai rambut atau lebih (sengaja)</option>
          <option value="cukur-rambut-terlupa">Mencukur rambut dalam keadaan terlupa</option>
          <option value="potong-kuku">Mengerat kuku 3 helai atau lebih</option>
          <option value="bunuh-binatang">Membunuh binatang buruan dalam Tanah Haram</option>
        </optgroup>
        <optgroup label="Pelanggaran Taraffuh (keseronokan)">
          <option value="wangian-sengaja">Memakai wangian dengan sengaja</option>
          <option value="wangian-terlupa">Memakai wangian dalam keadaan terlupa</option>
          <option value="jahitan-lelaki">Lelaki memakai pakaian berjahit</option>
          <option value="tutup-kepala-lelaki">Lelaki menutup kepala (tutup melekat)</option>
          <option value="tutup-muka-wanita">Wanita menutup muka dengan kain melekat</option>
          <option value="sarung-tangan">Wanita memakai sarung tangan</option>
        </optgroup>
        <optgroup label="Meninggalkan Wajib Haji">
          <option value="tinggal-mabit">Meninggalkan mabit di Muzdalifah/Mina</option>
          <option value="tinggal-tawaf-wada">Meninggalkan tawaf wada</option>
          <option value="tinggal-melontar">Meninggalkan melontar jamrah</option>
          <option value="tinggal-niat-miqat">Tertinggal miqat tanpa berihram</option>
        </optgroup>
        <optgroup label="Lain-lain">
          <option value="ihsar">Dam Ihsar (terhalang ke Mekah selepas berihram)</option>
          <option value="hubungan-suami-isteri">Hubungan suami isteri ketika ihram (sebelum tahallul awal)</option>
        </optgroup>
      </select>

      <p class="text-xs text-[var(--color-stone-warm)] mt-3">
        Tidak nampak situasi anda? Rujuk
        <a href="/artikel/persoalan/dam-haji-kategori-kadar-tempat-bayar/"
           class="text-[var(--color-teal)] underline">artikel lengkap dam</a>
        atau
        <a href="https://muftiwp.gov.my/" rel="noopener"
           class="text-[var(--color-teal)] underline">Mufti WP</a>.
      </p>
    </div>

    {/* ─────── OUTPUT ─────── */}
    <div id="dam-result" class="hidden">
      <div class="bg-[var(--color-teal-soft)] border-l-4 border-[var(--color-teal)] rounded-r-lg p-6 md:p-8 mb-6">
        <div class="flex items-baseline gap-3 mb-3 flex-wrap">
          <span id="dam-category-pill" class="badge badge-teal text-xs"></span>
          <span id="dam-type-label" class="text-sm text-[var(--color-stone-warm)]"></span>
        </div>
        <h2 id="dam-headline" class="text-2xl font-semibold text-[var(--color-ink)] mb-3"
            style="font-family: var(--font-serif);"></h2>
        <p id="dam-explanation" class="text-[var(--color-ink)] mb-4"></p>

        <div id="dam-options" class="space-y-3 mb-4"></div>

        <div id="dam-amount" class="text-lg font-medium text-[var(--color-ink)] mb-4"></div>

        <details class="text-sm">
          <summary class="cursor-pointer text-[var(--color-teal)] font-medium">
            Sumber rujukan
          </summary>
          <ul id="dam-sources" class="mt-2 space-y-1 list-disc list-inside text-[var(--color-ink)]"></ul>
        </details>
      </div>

      <div class="bg-saffron-50 border border-saffron-200 rounded-lg p-5 text-sm text-[var(--color-ink)]">
        <p class="font-medium text-[var(--color-ink)] mb-1">⚠ Disclaimer penting</p>
        <p>
          Kalkulator ini panduan umum. Untuk kes khusus (uzur kesihatan,
          kekangan kewangan, kombinasi pelanggaran), rujuk pegawai Tabung
          Haji atau hubungi Mufti WP secara langsung. Kadar ADAHI boleh
          berubah setiap musim haji.
        </p>
      </div>
    </div>

    {/* ─────── FOOTER LINKS ─────── */}
    <div class="mt-12 pt-8 border-t border-[var(--color-rule)]">
      <h2 class="text-xl font-semibold text-[var(--color-ink)] mb-4">
        Bacaan lanjut
      </h2>
      <ul class="space-y-2 text-[var(--color-ink)]">
        <li>
          →
          <a href="/artikel/persoalan/dam-haji-kategori-kadar-tempat-bayar/"
             class="text-[var(--color-teal)] underline">
            Dam Haji dan Umrah: Kategori, Kadar, dan Tempat Pembayaran
          </a>
        </li>
        <li>
          →
          <a href="/panduan/ihram-miqat/larangan-ihram-lelaki-wanita-perbezaan/"
             class="text-[var(--color-teal)] underline">
            Senarai Lengkap Larangan Ihram Lelaki dan Wanita
          </a>
        </li>
        <li>
          →
          <a href="/panduan/haji/wajib-haji-tujuh-perkara/"
             class="text-[var(--color-teal)] underline">
            Wajib Haji: Tujuh Perkara dan Dam Jika Ditinggalkan
          </a>
        </li>
        <li>
          →
          <a href="/panduan/ihram-miqat/ihram-pampers-sanitizer-payung-hukum/"
             class="text-[var(--color-teal)] underline">
            Pampers, Sanitizer, dan Payung Semasa Ihram: Halal atau Dam
          </a>
        </li>
      </ul>
    </div>
  </section>

  <script is:inline>
