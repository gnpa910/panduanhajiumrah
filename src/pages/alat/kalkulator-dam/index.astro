      color: #fff;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .bg-saffron-50 { background-color: #fef9ec; }
    .border-saffron-200 { border-color: #f7e3a3; }
  </style>
</BaseLayout>
