  },
  {
    id: "kewangan",
    title: "Kewangan & Pembayaran",
    icon: "💰",
    items: [
      "Wang saku Saudi Riyal (SAR) — tukar sebelum berlepas",
      "Kad debit / kredit antarabangsa (aktifkan luar negara)",
      "Dompet kecil / pouch untuk wang harian",
      "Simpan wang di 2–3 tempat berasingan (beg pinggang, poket dalaman)",
      "Bawa sedikit USD sebagai backup",
      "Senarai bayaran tambahan: dam, qurban, cenderahati",
    ],
  },
  {
    id: "pakaian",
    title: "Pakaian & Ihram",
    icon: "👕",
    items: [
      "Kain ihram (2 helai — putih, tidak berjahit) — lelaki",
      "Baju ihram / pakaian labuh longgar — wanita",
      "Selipar / sandal Jepun (tidak bertutup tumit & jari kaki) — lelaki",
      "Pakaian harian yang sopan & longgar (4–5 set)",
      "Stokin tebal (untuk ke masjid)",
      "Tudung / telekung wanita (2–3 set)",
      "Baju sejuk / jaket ringan (masjid berhawa dingin)",
      "Pakaian dalam secukupnya",
      "Tali pinggang berzip (simpan wang ketika ihram)",
    ],
  },
  {
    id: "kesihatan",
    title: "Kesihatan & Ubatan",
    icon: "💊",
    items: [
      "Ubat preskripsi dokter (bekalan mencukupi + salinan preskripsi)",
      "Paracetamol / panadol",
      "Ubat selesema / batuk",
      "Ubat cirit-birit / loh smecta",
      "Minyak angin / balm",
      "Plaster luka / band-aid",
      "Ubat titis mata (kering / debu pasir)",
      "Krim pelindung matahari SPF50+",
      "Losyen / pelembap kulit (udara kering)",
      "Garam ORS (cegah dehidrasi)",
      "Vitamin C / multivitamin",
      "Penutup hidung / mask (debu Mina / Muzdalifah)",
    ],
  },
  {
    id: "keperluan-harian",
    title: "Keperluan Harian",
    icon: "🎒",
    items: [
      "Botol air boleh isi semula (1L minimum)",
      "Payung kecil (lindung dari panas terik)",
      "Tuala kecil / tuala basah",
      "Sabun & syampu kecil (botol travel)",
