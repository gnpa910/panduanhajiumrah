---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const siteUrl = Astro.site ?? new URL("https://panduanhajiumrah.vercel.app");
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Laman Utama", item: siteUrl.href },
    { "@type": "ListItem", position: 2, name: "Alat", item: new URL("/alat/", siteUrl).href },
    { "@type": "ListItem", position: 3, name: "Zikir Counter (Tasbih Digital)", item: pageUrl },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Zikir Counter — Tasbih Digital",
  description:
    "Alat tasbih digital untuk menghitung zikir harian — Subhanallah, Alhamdulillah, Allahu Akbar, dan lain-lain. Dengan progress ring, getaran haptik, dan statistik harian.",
  applicationCategory: "ReligionApplication",
  operatingSystem: "Web",
  inLanguage: "ms-MY",
  isAccessibleForFree: true,
  url: pageUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "MYR" },
};
---

<BaseLayout
  title="Zikir Counter — Tasbih Digital"
  description="Alat tasbih digital untuk menghitung zikir harian: Subhanallah, Alhamdulillah, Allahu Akbar, La ilaha illallah, Astaghfirullah. Dengan progress ring, getaran haptik, dan statistik harian."
  jsonLd={[breadcrumbSchema, webAppSchema]}
>
  <section class="max-w-2xl mx-auto px-4 py-10">
    {/* breadcrumb */}
    <nav class="text-sm text-[var(--color-stone-warm)] mb-6 print:hidden" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--color-teal)]">Laman Utama</a>
      <span class="mx-2">›</span>
      <a href="/alat/" class="hover:text-[var(--color-teal)]">Alat</a>
      <span class="mx-2">›</span>
      <span class="text-[var(--color-ink)]">Zikir Counter</span>
    </nav>

    <header class="mb-8">
      <p class="badge badge-teal mb-4">Alat Interaktif · Tasbih Digital</p>
      <h1
        class="text-4xl md:text-5xl font-semibold text-[var(--color-ink)] mb-4"
        style="font-family: var(--font-serif);"
      >
        Zikir Counter
      </h1>
      <p class="text-lg text-[var(--color-ink)] max-w-2xl">
        Tekan butang besar di bawah untuk menghitung zikir. Pilih zikir sasaran atau tetapkan sasaran sendiri. Alat ini menggunakan getaran haptik dan simpanan tempatan (localStorage).
      </p>
    </header>

    {/* ─────── PRESET ZIKIR BUTTONS ─────── */}
    <div class="bg-[var(--color-surface)] border border-[var(--color-rule)] rounded-lg p-6 mb-6 shadow-sm print:hidden">
      <h2 class="text-sm font-semibold text-[var(--color-ink)] mb-3">Pilih Zikir</h2>
      <div id="preset-grid" class="grid grid-cols-2 md:grid-cols-3 gap-2">
        <button
          class="preset-btn text-left px-3 py-2.5 rounded-md border border-[var(--color-rule)] hover:border-[var(--color-teal)] hover:bg-[var(--color-teal-soft)] transition text-sm"
          data-zikir="subhanallah"
          data-arabic="سُبْحَانَ اللَّهِ"
          data-target="33"
        >
          <span class="block font-medium text-[var(--color-ink)]">Subhanallah</span>
          <span class="block text-xs text-[var(--color-stone-warm)] mt-0.5" dir="rtl">سُبْحَانَ اللَّهِ · 33×</span>
        </button>
        <button
          class="preset-btn text-left px-3 py-2.5 rounded-md border border-[var(--color-rule)] hover:border-[var(--color-teal)] hover:bg-[var(--color-teal-soft)] transition text-sm"
          data-zikir="alhamdulillah"
          data-arabic="الْحَمْدُ لِلَّهِ"
          data-target="34"
        >
          <span class="block font-medium text-[var(--color-ink)]">Alhamdulillah</span>
          <span class="block text-xs text-[var(--color-stone-warm)] mt-0.5" dir="rtl">الْحَمْدُ لِلَّهِ · 34×</span>
        </button>
        <button
          class="preset-btn text-left px-3 py-2.5 rounded-md border border-[var(--color-rule)] hover:border-[var(--color-teal)] hover:bg-[var(--color-teal-soft)] transition text-sm"
          data-zikir="allahu-akbar"
          data-arabic="اللَّهُ أَكْبَرُ"
          data-target="34"
        >
          <span class="block font-medium text-[var(--color-ink)]">Allahu Akbar</span>
          <span class="block text-xs text-[var(--color-stone-warm)] mt-0.5" dir="rtl">اللَّهُ أَكْبَرُ · 34×</span>
        </button>
        <button
          class="preset-btn text-left px-3 py-2.5 rounded-md border border-[var(--color-rule)] hover:border-[var(--color-teal)] hover:bg-[var(--color-teal-soft)] transition text-sm"
          data-zikir="la-ilaha"
          data-arabic="لَا إِلَٰهَ إِلَّا اللَّهُ"
          data-target="0"
        >
          <span class="block font-medium text-[var(--color-ink)]">La ilaha illallah</span>
          <span class="block text-xs text-[var(--color-stone-warm)] mt-0.5" dir="rtl">لَا إِلَٰهَ إِلَّا اللَّهُ · ∞</span>
        </button>
        <button
          class="preset-btn text-left px-3 py-2.5 rounded-md border border-[var(--color-rule)] hover:border-[var(--color-teal)] hover:bg-[var(--color-teal-soft)] transition text-sm"
          data-zikir="astaghfirullah"
          data-arabic="أَسْتَغْفِرُ اللَّهَ"
          data-target="0"
        >
          <span class="block font-medium text-[var(--color-ink)]">Astaghfirullah</span>
          <span class="block text-xs text-[var(--color-stone-warm)] mt-0.5" dir="rtl">أَسْتَغْفِرُ اللَّهَ · ∞</span>
        </button>
        <button
          class="preset-btn text-left px-3 py-2.5 rounded-md border border-[var(--color-rule)] hover:border-[var(--color-teal)] hover:bg-[var(--color-teal-soft)] transition text-sm"
          data-zikir="custom"
          data-arabic=""
          data-target="0"
        >
          <span class="block font-medium text-[var(--color-ink)]">Custom</span>
          <span class="block text-xs text-[var(--color-stone-warm)] mt-0.5">Tetapkan sasaran sendiri</span>
        </button>
      </div>

      {/* Custom target input — hidden by default */}
      <div id="custom-target-wrap" class="hidden mt-3">
        <label for="custom-target" class="block text-xs font-medium text-[var(--color-stone-warm)] mb-1">Sasaran (bilangan)</label>
        <input
          id="custom-target"
          type="number"
          min="1"
          max="99999"
          placeholder="cth: 100"
          class="w-40 px-3 py-2 border border-[var(--color-rule)] rounded-md text-sm focus:border-[var(--color-teal)] focus:outline-none focus:ring-2 focus:ring-[var(--color-teal)]/30"
        />
      </div>
    </div>

    {/* ─────── COUNTER DISPLAY ─────── */}
    <div id="counter-area" class="print:hidden">
      {/* Zikir name */}
      <p id="active-zikir-label" class="text-center text-sm text-[var(--color-stone-warm)] mb-2">
        Pilih zikir di atas, kemudian tekan di bawah
      </p>
      <p id="active-arabic" class="text-center text-2xl text-[var(--color-ink)] mb-6" dir="rtl" style="font-family: var(--font-serif);"></p>

      {/* Progress ring + count */}
      <div class="flex justify-center mb-6">
        <div id="tap-area" class="relative w-64 h-64 md:w-72 md:h-72 cursor-pointer select-none tap-area">
          {/* SVG progress ring */}
          <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 200 200">
            <circle
              id="ring-bg"
              cx="100" cy="100" r="90"
              fill="none" stroke="#e7e5e4" stroke-width="8"
            />
            <circle
              id="ring-fg"
              cx="100" cy="100" r="90"
              fill="none" stroke="#059669" stroke-width="8"
              stroke-linecap="round"
              stroke-dasharray="565.48"
              stroke-dashoffset="565.48"
              style="transition: stroke-dashoffset 0.2s ease;"
            />
          </svg>
          {/* Count text */}
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span id="count-display" class="text-6xl md:text-7xl font-bold text-[var(--color-ink)]" style="font-family: var(--font-serif);">0</span>
            <span id="target-display" class="text-xs text-[var(--color-stone-warm)] mt-1"></span>
          </div>
        </div>
      </div>

      {/* Tap instruction */}
      <p class="text-center text-xs text-[var(--color-stone-warm)] mb-6">Tekan bulatan atau di mana-mana sahaja</p>

      {/* Action buttons */}
      <div class="flex justify-center gap-3 mb-8">
        <button id="undo-btn" class="px-4 py-2 rounded-md border border-[var(--color-rule)] text-sm font-medium text-[var(--color-ink)] hover:bg-stone-100 transition disabled:opacity-40 disabled:cursor-not-allowed" disabled>
          ↩ Undo
        </button>
        <button id="reset-btn" class="px-4 py-2 rounded-md border border-[var(--color-rule)] text-sm font-medium text-[var(--color-ink)] hover:bg-stone-100 transition">
          ✕ Reset
        </button>
      </div>
    </div>

    {/* ─────── SESSION STATS ─────── */}
    <div class="bg-[var(--color-surface)] border border-[var(--color-rule)] rounded-lg p-6 mb-6 shadow-sm">
      <h2 class="text-sm font-semibold text-[var(--color-ink)] mb-3">📊 Statistik Hari Ini</h2>
      <div class="grid grid-cols-2 gap-4 text-center">
        <div>
          <p id="stat-total" class="text-3xl font-bold text-[var(--color-teal)]" style="font-family: var(--font-serif);">0</p>
          <p class="text-xs text-[var(--color-stone-warm)]">Jumlah zikir hari ini</p>
        </div>
        <div>
          <p id="stat-sessions" class="text-3xl font-bold text-[var(--color-teal)]" style="font-family: var(--font-serif);">0</p>
          <p class="text-xs text-[var(--color-stone-warm)]">Sesi selesai</p>
        </div>
      </div>
    </div>

    {/* ─────── PRINT SUMMARY ─────── */}
    <div id="print-summary" class="hidden print:block">
      <h2 class="text-xl font-semibold mb-2">Ringkasan Zikir Hari Ini</h2>
      <p>Jumlah zikir: <strong id="print-total">0</strong></p>
      <p>Sesi selesai: <strong id="print-sessions">0</strong></p>
    </div>

    {/* ─────── INFO ─────── */}
    <div class="bg-[var(--color-teal-soft)] border-l-4 border-[var(--color-teal)] rounded-r-lg p-5 text-sm text-[var(--color-ink)] mb-6">
      <p class="font-medium text-[var(--color-ink)] mb-1">ℹ️ Tentang Zikir Tasbih</p>
      <p>
        Selepas solat fardhu, disunatkan membaca <strong>Subhanallah</strong> (33×),
        <strong>Alhamdulillah</strong> (34×), dan <strong>Allahu Akbar</strong> (34×)
        — sebanyak 100 kali secara keseluruhan. Ini berdasarkan hadis riwayat
        Muslim (596) daripada Abu Hurairah r.a.
      </p>
    </div>

    {/* ─────── FOOTER LINKS ─────── */}
    <div class="mt-12 pt-8 border-t border-[var(--color-rule)] print:hidden">
      <h2 class="text-xl font-semibold text-[var(--color-ink)] mb-4">
        Bacaan lanjut
      </h2>
      <ul class="space-y-2 text-[var(--color-ink)]">
        <li>
          →
          <a href="/artikel/amalan/zikir-selepas-solat/"
             class="text-[var(--color-teal)] underline">
            Zikir Selepas Solat: Bilangan dan Lafaz
          </a>
        </li>
        <li>
          →
          <a href="/alat/"
             class="text-[var(--color-teal)] underline">
            Senarai Alat Interaktif
          </a>
        </li>
      </ul>
    </div>
  </section>

  <style>
    .tap-area {
      background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
      border-radius: 9999px;
      border: 2px solid #d1d5db;
      transition: transform 0.08s ease, border-color 0.2s ease;
    }
    .tap-area:active {
      transform: scale(0.95);
    }
    .tap-area.flash {
      animation: flash-ring 0.4s ease;
    }
    @keyframes flash-ring {
      0% { border-color: #059669; box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.5); }
      50% { border-color: #059669; box-shadow: 0 0 30px 10px rgba(5, 150, 105, 0.3); }
      100% { border-color: #d1d5db; box-shadow: none; }
    }
    .preset-btn.active {
      border-color: #059669;
      background-color: #ecfdf5;
      box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);
    }
    .count-bump {
      animation: bump 0.12s ease;
    }
    @keyframes bump {
      0% { transform: scale(1); }
      50% { transform: scale(1.08); }
      100% { transform: scale(1); }
    }
    @media print {
      .print\:hidden { display: none !important; }
      #print-summary { display: block !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const CIRCUMFERENCE = 2 * Math.PI * 90; // ~565.48
      const LS_KEY = "zikir-counter-data";
      const today = new Date().toISOString().slice(0, 10);

      // Elements
      const presetBtns = document.querySelectorAll(".preset-btn");
      const customWrap = document.getElementById("custom-target-wrap");
      const customInput = document.getElementById("custom-target");
      const tapArea = document.getElementById("tap-area");
      const countDisplay = document.getElementById("count-display");
      const targetDisplay = document.getElementById("target-display");
      const activeLabel = document.getElementById("active-zikir-label");
      const activeArabic = document.getElementById("active-arabic");
      const ringFg = document.getElementById("ring-fg");
      const undoBtn = document.getElementById("undo-btn");
      const resetBtn = document.getElementById("reset-btn");
      const statTotal = document.getElementById("stat-total");
      const statSessions = document.getElementById("stat-sessions");
      const printTotal = document.getElementById("print-total");
      const printSessions = document.getElementById("print-sessions");

      let state = loadState();

      function loadState() {
        try {
          const raw = localStorage.getItem(LS_KEY);
          if (raw) {
            const d = JSON.parse(raw);
            if (d.date !== today) {
              // New day — reset counts, keep daily totals
              return {
                date: today,
                zikir: d.zikir || "subhanallah",
                arabic: d.arabic || "سُبْحَانَ اللَّهِ",
                target: d.target || 33,
                count: 0,
                dailyTotal: 0,
                dailySessions: 0,
              };
            }
            return d;
          }
        } catch {}
        return {
          date: today,
          zikir: "subhanallah",
          arabic: "سُبْحَانَ اللَّهِ",
          target: 33,
          count: 0,
          dailyTotal: 0,
          dailySessions: 0,
        };
      }

      function saveState() {
        try {
          localStorage.setItem(LS_KEY, JSON.stringify(state));
        } catch {}
      }

      function updateDisplay() {
        countDisplay.textContent = state.count;
        const target = state.target;

        // Progress ring
        if (target > 0) {
          const progress = Math.min(state.count / target, 1);
          const offset = CIRCUMFERENCE * (1 - progress);
          ringFg.setAttribute("stroke-dashoffset", offset);
          targetDisplay.textContent = `sasaran: ${target}`;
          ringFg.setAttribute("stroke", progress >= 1 ? "#f59e0b" : "#059669");
        } else {
          ringFg.setAttribute("stroke-dashoffset", CIRCUMFERENCE);
          targetDisplay.textContent = "tiada sasaran";
          ringFg.setAttribute("stroke", "#059669");
        }

        // Undo button
        undoBtn.disabled = state.count <= 0;

        // Active label
        const labels = {
          subhanallah: "Subhanallah",
          "alhamdulillah": "Alhamdulillah",
          "allahu-akbar": "Allahu Akbar",
          "la-ilaha": "La ilaha illallah",
          "astaghfirullah": "Astaghfirullah",
          custom: "Custom",
        };
        activeLabel.textContent = labels[state.zikir] || state.zikir;
        activeArabic.textContent = state.arabic || "";

        // Stats
        statTotal.textContent = state.dailyTotal;
        statSessions.textContent = state.dailySessions;
        printTotal.textContent = state.dailyTotal;
        printSessions.textContent = state.dailySessions;

        // Highlight active preset
        presetBtns.forEach((b) => {
          b.classList.toggle("active", b.dataset.zikir === state.zikir);
        });

        // Custom input
        customWrap.classList.toggle("hidden", state.zikir !== "custom");
      }

      function incrementCount() {
        state.count++;
        state.dailyTotal++;

        // Check target reached
        if (state.target > 0 && state.count === state.target) {
          if (navigator.vibrate) navigator.vibrate(100);
          tapArea.classList.add("flash");
          setTimeout(() => tapArea.classList.remove("flash"), 500);
          state.dailySessions++;
        } else {
          if (navigator.vibrate) navigator.vibrate(10);
        }

        // Bump animation
        countDisplay.classList.remove("count-bump");
        void countDisplay.offsetWidth;
        countDisplay.classList.add("count-bump");

        saveState();
        updateDisplay();
      }

      // Tap area
      tapArea.addEventListener("click", incrementCount);

      // Keyboard support
      document.addEventListener("keydown", (e) => {
        if (e.code === "Space" || e.code === "Enter") {
          e.preventDefault();
          incrementCount();
        }
      });

      // Undo
      undoBtn.addEventListener("click", () => {
        if (state.count > 0) {
          state.count--;
          state.dailyTotal = Math.max(0, state.dailyTotal - 1);
          saveState();
          updateDisplay();
        }
      });

      // Reset
      resetBtn.addEventListener("click", () => {
        if (state.count > 0) {
          siteConfirmDanger("Reset kiraan semasa ke 0?").then(function(ok) {
            if (!ok) return;
            state.count = 0;
            saveState();
            updateDisplay();
          });
        } else {
          state.count = 0;
          saveState();
          updateDisplay();
        }
      });

      // Preset buttons
      presetBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          function applyPreset() {
            const key = btn.dataset.zikir;
            const target = parseInt(btn.dataset.target, 10) || 0;
            const arabic = btn.dataset.arabic || "";

            state.zikir = key;
            state.target = target;
            state.arabic = arabic;
            state.count = 0;

            saveState();
            updateDisplay();
          }
          if (state.count > 0) {
            siteConfirm("Tukar zikir? Kiraan semasa akan di-reset.").then(function(ok) {
              if (ok) applyPreset();
            });
          } else {
            applyPreset();
          }
        });
      });

      // Custom target input
      customInput.addEventListener("input", () => {
        const val = parseInt(customInput.value, 10);
        if (val > 0) {
          state.target = val;
          state.count = 0;
          saveState();
          updateDisplay();
        }
      });

      // Init
      updateDisplay();
    })();
  </script>
</BaseLayout>