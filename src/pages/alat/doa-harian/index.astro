---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const categories = [
  { id: "musafir", label: "Doa Musafir", icon: "✈️" },
  { id: "masjid", label: "Doa Masjid", icon: "🕌" },
  { id: "haji-umrah", label: "Doa Ibadah Haji/Umrah", icon: "🕋" },
  { id: "harian", label: "Doa Harian di Tanah Suci", icon: "☀️" },
];

const doas = [
  {
    id: "doa-keluar-rumah",
    audio: "/audio/doa-keluar-rumah.mp3",
    category: "musafir",
    title: "Doa Keluar Rumah",
    arabic: "بِسْمِ اللَّهِ، تَوَكَّلْتُ عَلَى اللَّهِ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ",
    transliteration: "Bismillah, tawakkaltu 'alallah, wa la hawla wa la quwwata illa billah.",
    translation: "Dengan nama Allah, aku bertawakal kepada Allah, dan tiada daya dan kekuatan melainkan dengan pertolongan Allah.",
    source: "HR Abu Dawud 5095",
  },
  {
    id: "doa-naik-kenderaan",
    audio: "/audio/doa-naik-kenderaan.mp3",
    category: "musafir",
    title: "Doa Naik Kenderaan",
    arabic: "سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ وَإِنَّا إِلَىٰ رَبِّنَا لَمُنقَلِبُونَ",
    transliteration: "Subhanalladzi sakhkharalana hadha wa ma kunna lahu muqrinin wa inna ila rabbina la munqalibun.",
    translation: "Maha Suci Allah yang telah menundukkan semua ini untuk kami padahal kami sebelumnya tidak mampu menguasainya, dan sesungguhnya kami akan kembali kepada Tuhan kami.",
    source: "HR Zukhruf 43:13",
  },
  {
    id: "doa-safar",
    audio: "/audio/doa-safar.mp3",
    category: "musafir",
    title: "Doa Safar",
    arabic: "اللَّهُمَّ إِنِّي أَسْأَلُكَ فِي سَفَرِي هَذَا الْبِرَّ وَالتَّقْوَى، وَمِنَ الْعَمَلِ مَا تَرْضَى، اللَّهُمَّ هَوِّنْ عَلَيْنَا سَفَرَنَا هَذَا وَاطْوِ عَنَّا بُعْدَهُ، اللَّهُمَّ أَنْتَ الصَّاحِبُ فِي السَّفَرِ وَالْخَلِيفَةُ فِي الْأَهْلِ",
    transliteration: "Allahumma inni as'aluka fi safarika hadha al-birra wa al-taqwa, wa min al-'amal ma tardla. Allahumma hawwin 'alayna safarana hadha wa atwi 'annahu bu'dahu. Allahumma anta al-sahibu fi al-safar wa al-khalifatu fi al-ahl.",
    translation: "Ya Allah, sesungguhnya aku memohon kepada-Mu dalam perjalanan ini kebaikan dan ketakwaan, serta amal yang Engkau redhai. Ya Allah, mudahkanlah perjalanan kami ini dan dekatkanlah jaraknya. Ya Allah, Engkau adalah teman dalam perjalanan dan pengganti (pelindung) keluarga.",
    source: "HR Muslim 1342",
  },
  {
    id: "doa-masuk-masjid",
    audio: "/audio/doa-masuk-masjid.mp3",
    category: "masjid",
    title: "Doa Masuk Masjid",
    arabic: "اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ",
    transliteration: "Allahumma-ftah li abwaba rahmatik.",
    translation: "Ya Allah, bukakanlah untukku pintu-pintu rahmat-Mu.",
    source: "HR Muslim 713",
  },
  {
    id: "doa-keluar-masjid",
    audio: "/audio/doa-keluar-masjid.mp3",
    category: "masjid",
    title: "Doa Keluar Masjid",
    arabic: "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ",
    transliteration: "Allahumma inni as'aluka min fadlik.",
    translation: "Ya Allah, sesungguhnya aku memohon kepada-Mu akan kurnia-Mu.",
    source: "HR Muslim 713",
  },
  {
    id: "talbiyah",
    audio: "/audio/talbiyah.mp3",
    category: "haji-umrah",
    title: "Talbiyah",
    arabic: "لَبَّيْكَ اللَّهُمَّ لَبَّيْكَ، لَبَّيْكَ لَا شَرِيكَ لَكَ لَبَّيْكَ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ، لَا شَرِيكَ لَكَ",
    transliteration: "Labbayk Allahumma labbayk, labbayka la sharika laka labbayk, innal hamda wa al-ni'mata laka wa al-mulk, la sharika lak.",
    translation: "Aku penuhi panggilan-Mu ya Allah, aku penuhi panggilan-Mu. Aku penuhi panggilan-Mu, tiada sekutu bagi-Mu, aku penuhi panggilan-Mu. Sesungguhnya segala pujian, nikmat dan kerajaan adalah milik-Mu, tiada sekutu bagi-Mu.",
    source: "HR Bukhari 1549",
  },
  {
    id: "doa-melihat-kaabah",
    audio: "/audio/doa-melihat-kaabah.mp3",
    category: "haji-umrah",
    title: "Doa Melihat Kaabah",
    arabic: "اللَّهُمَّ زِدْ هَذَا الْبَيْتَ تَشْرِيفًا وَتَعْظِيمًا وَتَكْرِيمًا وَمَهَابَةً، وَزِدْ مِنْ شَرَّفَهُ وَعَظَّمَهُ مِنَ الْحَجِّ وَالْعُمْرَةِ تَشْرِيفًا وَتَكْرِيمًا وَتَعْظِيمًا وَبِرًّا",
    transliteration: "Allahumma zid hadha al-bayta tashrifan wa ta'zhiman wa takriman wa mahabah, wa zid man sharrafahu wa 'azzamahu min al-hajji wa al-'umrati tashrifan wa takriman wa ta'zhiman wa birra.",
    translation: "Ya Allah, tambahkanlah kemuliaan, keagungan, kehormatan dan kehebatan bagi Baitullah ini. Dan tambahkanlah bagi orang yang memuliakan dan mengagungkannya dari kalangan jemaah haji dan umrah, kemuliaan, kehormatan, keagungan dan kebaikan.",
    source: "HR at-Tabrani",
  },
  {
    id: "doa-rukun-yamani",
    audio: "/audio/doa-rukun-yamani.mp3",
    category: "haji-umrah",
    title: "Doa Rukun Yamani",
    arabic: "رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ",
    transliteration: "Rabbana atina fi al-dunya hasanah wa fi al-akhirati hasanah wa qina 'adhab al-nar.",
    translation: "Ya Tuhan kami, berikanlah kami kebaikan di dunia dan kebaikan di akhirat, dan peliharalah kami dari azab neraka.",
    source: "HR Bukhari 4530",
  },
  {
    id: "doa-hijr-ismail",
    audio: "/audio/doa-hijr-ismail.mp3",
    category: "haji-umrah",
    title: "Doa Hijr Ismail",
    arabic: "رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ خَيْرُ الرَّاحِمِينَ، وَأَدْخِلْنِي فِي عِبَادِكَ الصَّالِحِينَ",
    transliteration: "Rabbi ghfir warham wa anta khair al-rahimin, wa adkhilni fi 'ibadika al-salihin.",
    translation: "Ya Tuhanku, ampunilah dan rahmatilah Engkau sebaik-baik Pemberi rahmat. Dan masukkanlah aku ke dalam golongan hamba-hamba-Mu yang soleh.",
    source: "Panduan Ibadah Haji & Umrah",
  },
  {
    id: "doa-pagi-petang",
    audio: "/audio/doa-pagi-petang.mp3",
    category: "harian",
    title: "Doa Pagi & Petang",
    arabic: "اللَّهُمَّ بِكَ أَصْبَحْنَا وَبِكَ أَمْسَيْنَا وَبِكَ نَحْيَا وَبِكَ نَمُوتُ وَإِلَيْكَ النُّشُورُ",
    transliteration: "Allahumma bika asbahna wa bika amsayna wa bika nahya wa bika namutu wa ilayka al-nushur.",
    translation: "Ya Allah, dengan-Mu kami memasuki waktu pagi, dengan-Mu kami memasuki waktu petang, dengan-Mu kami hidup, dengan-Mu kami mati, dan kepada-Mu kami dibangkitkan semula.",
    source: "HR Muslim 2723",
  },
  {
    id: "doa-sebelum-tidur",
    audio: "/audio/doa-sebelum-tidur.mp3",
    category: "harian",
    title: "Doa Sebelum Tidur",
    arabic: "بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا",
    transliteration: "Bismika Allahumma amutu wa ahya.",
    translation: "Dengan nama-Mu ya Allah, aku mati dan aku hidup.",
    source: "HR Bukhari 6324",
  },
  {
    id: "doa-bangun-tidur",
    audio: "/audio/doa-bangun-tidur.mp3",
    category: "harian",
    title: "Doa Bangun Tidur",
    arabic: "الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ",
    transliteration: "Alhamdulillalladzi ahyana ba'da ma amatana wa ilayhi al-nushur.",
    translation: "Segala puji bagi Allah yang telah menghidupkan kami setelah mematikan kami, dan kepada-Nya kami dibangkitkan.",
    source: "HR Bukhari 6314",
  },
];
---

<BaseLayout
  title="Doa Harian Haji & Umrah"
  description="Koleksi doa harian lengkap untuk jemaah haji dan umrah — doa musafir, doa masjid, doa ibadah haji/umrah, dan doa harian di tanah suci. Lengkap dengan teks Arab, transliterasi dan terjemahan."
>
  <style>
    .doa-arabic {
      font-size: 1.5rem;
      line-height: 2.2;
      direction: rtl;
      text-align: right;
      font-family: 'Amiri', 'Traditional Arabic', serif;
    }
    @media print {
      .no-print { display: none !important; }
      .doa-card { break-inside: avoid; page-break-inside: avoid; }
      .doa-item { display: block !important; }
      body { font-size: 11pt; }
      .doa-arabic { font-size: 1.3rem; }
      .filter-bar, .search-bar, .action-bar { display: none !important; }
    }
  </style>

  <section class="max-w-3xl mx-auto px-4 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="badge badge-teal mb-4">Alat Interaktif</p>
      <h1
        class="text-3xl md:text-4xl font-semibold text-[var(--color-ink)] mb-4"
        style="font-family: var(--font-serif);"
      >
        Doa Harian Haji & Umrah
      </h1>
      <p class="text-[var(--color-stone-warm)] max-w-lg mx-auto leading-relaxed">
        Koleksi doa lengkap untuk jemaah haji dan umrah — dari keluar rumah sehingga kembali. Dengar sebutan Arab, salin teks, atau cetak untuk rujukan mudah.
      </p>
    </div>

    {/* Search & Actions */}
    <div class="search-bar flex flex-col sm:flex-row gap-3 mb-6">
      <input
        type="text"
        id="doa-search"
        placeholder="Cari doa..."
        class="flex-1 px-4 py-2.5 border border-stone-200 rounded-lg text-sm text-[var(--color-ink)] placeholder:text-[var(--color-stone-warm)] focus:outline-none focus:ring-2 focus:ring-[var(--color-teal)] focus:border-transparent bg-white"
      />
      <div class="action-bar flex gap-2">
        <button
          id="btn-print"
          type="button"
          class="px-4 py-2.5 text-sm font-medium border border-stone-200 rounded-lg text-[var(--color-ink)] hover:bg-[var(--color-surface)] transition-colors no-print"
          title="Cetak semua doa"
        >
          🖨️ Cetak
        </button>
        <button
          id="btn-expand-all"
          type="button"
          class="px-4 py-2.5 text-sm font-medium border border-stone-200 rounded-lg text-[var(--color-ink)] hover:bg-[var(--color-surface)] transition-colors no-print"
        >
          Buka/Tutup Semua
        </button>
      </div>
    </div>

    {/* Category Filter Tabs */}
    <div class="filter-bar flex flex-wrap gap-2 mb-8">
      <button
        type="button"
        class="category-tab active px-3.5 py-1.5 text-sm font-medium rounded-full border border-stone-200 text-[var(--color-ink)] hover:border-[var(--color-teal)] hover:text-[var(--color-teal)] transition-colors bg-[var(--color-teal)] text-white border-[var(--color-teal)]"
        data-category="all"
      >
        Semua
      </button>
      {categories.map((cat) => (
        <button
          type="button"
          class="category-tab px-3.5 py-1.5 text-sm font-medium rounded-full border border-stone-200 text-[var(--color-ink)] hover:border-[var(--color-teal)] hover:text-[var(--color-teal)] transition-colors"
          data-category={cat.id}
        >
          {cat.icon} {cat.label}
        </button>
      ))}
    </div>

    {/* Count */}
    <p id="doa-count" class="text-sm text-[var(--color-stone-warm)] mb-6">
      Menunjukkan {doas.length} doa
    </p>

    {/* Doa Cards by Category */}
    {categories.map((cat) => (
      <div class="doa-category mb-8" data-cat={cat.id}>
        <h2
          class="text-xl font-semibold text-[var(--color-ink)] mb-4 flex items-center gap-2"
          style="font-family: var(--font-serif);"
        >
          <span>{cat.icon}</span> {cat.label}
        </h2>
        <div class="space-y-4">
          {doas.filter(d => d.category === cat.id).map((doa) => (
            <div class="doa-card bg-white border border-stone-200 rounded-lg p-5 hover:shadow-md transition-shadow" data-category={doa.category} data-title={doa.title.toLowerCase()}>
              <div class="flex items-start justify-between mb-3">
                <h3 class="font-semibold text-[var(--color-ink)]" style="font-family: var(--font-serif);">
                  {doa.title}
                </h3>
                <span class="badge badge-teal text-xs whitespace-nowrap ml-2">{cat.label}</span>
              </div>

              {/* Arabic */}
              <blockquote class="doa-arabic bg-[var(--color-surface)] border-r-4 border-[var(--color-teal)] p-4 rounded-lg mb-4 text-[var(--color-ink)]">
                {doa.arabic}
              </blockquote>

              {/* Audio + Copy buttons */}
              <div class="flex justify-end gap-3 mb-3 no-print">
                {doa.audio && (
                  <button
                    type="button"
                    class="audio-btn text-xs text-[var(--color-stone-warm)] hover:text-[var(--color-teal)] transition-colors underline flex items-center gap-1"
                    data-audio={doa.audio}
                    data-id={doa.id}
                  >
                    <svg class="audio-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
                    <span class="audio-label">Dengar</span>
                  </button>
                )}
                <button
                  type="button"
                  class="copy-btn text-xs text-[var(--color-stone-warm)] hover:text-[var(--color-teal)] transition-colors underline"
                  data-arabic={doa.arabic}
                >
                  📋 Salin teks Arab
                </button>
              </div>

              {/* Transliteration */}
              <p class="text-sm italic text-[var(--color-stone-warm)] mb-2">
                <strong>Transliterasi:</strong> {doa.transliteration}
              </p>

              {/* Translation */}
              <p class="text-sm text-[var(--color-ink-soft)] mb-2 leading-relaxed">
                <strong>Terjemahan:</strong> {doa.translation}
              </p>

              {/* Source */}
              <p class="text-xs text-[var(--color-stone-warm)]">
                📖 {doa.source}
              </p>
            </div>
          ))}
        </div>
      </div>
    ))}

    {/* No results */}
    <div id="no-results" class="hidden text-center py-12 text-[var(--color-stone-warm)]">
      <p class="text-4xl mb-3">🔍</p>
      <p>Tiada doa dijumpai. Cuba carian lain.</p>
    </div>

    {/* Tip */}
    <div class="mt-10 p-5 bg-[var(--color-saffron-soft)] border border-[var(--color-saffron)] border-opacity-30 rounded-lg no-print">
      <p class="text-sm text-[var(--color-ink)] leading-relaxed">
        <strong>💡 Tip:</strong> Tekan butang "Dengar" untuk mendengar sebutan doa dalam bahasa Arab. Tekan "Cetak" untuk mencetak semua doa dalam format mudah dibaca. Gunakan tab kategori atau kotak carian untuk mencari doa tertentu.
      </p>
    </div>
  </section>

  {/* JSON-LD: WebApplication */}
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Doa Harian Haji & Umrah",
    "url": "https://panduanhajiumrah.com/alat/doa-harian",
    "description": "Koleksi doa harian lengkap untuk jemaah haji dan umrah dengan teks Arab, transliterasi dan terjemahan Bahasa Melayu.",
    "applicationCategory": "ReferenceApplication",
    "operatingSystem": "Web",
    "inLanguage": ["ms", "ar"],
  })} />

  {/* JSON-LD: BreadcrumbList */}
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Utama", "item": "https://panduanhajiumrah.com/" },
      { "@type": "ListItem", "position": 2, "name": "Alat", "item": "https://panduanhajiumrah.com/alat" },
      { "@type": "ListItem", "position": 3, "name": "Doa Harian", "item": "https://panduanhajiumrah.com/alat/doa-harian" }
    ]
  })} />
</BaseLayout>

<script is:inline>
  (function() {
    var searchInput = document.getElementById('doa-search');
    var btnPrint = document.getElementById('btn-print');
    var btnExpand = document.getElementById('btn-expand-all');
    var noResults = document.getElementById('no-results');
    var doaCount = document.getElementById('doa-count');
    var tabs = document.querySelectorAll('.category-tab');
    var categories = document.querySelectorAll('.doa-category');
    var cards = document.querySelectorAll('.doa-card');
    var copyBtns = document.querySelectorAll('.copy-btn');

    var activeCategory = 'all';

    // Category filter
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        activeCategory = tab.getAttribute('data-category');
        tabs.forEach(function(t) {
          t.classList.remove('active', 'bg-[var(--color-teal)]', 'text-white', 'border-[var(--color-teal)]');
        });
        tab.classList.add('active', 'bg-[var(--color-teal)]', 'text-white', 'border-[var(--color-teal)]');
        filterDoas();
      });
    });

    // Search
    searchInput.addEventListener('input', filterDoas);

    // Print
    btnPrint.addEventListener('click', function() {
      window.print();
    });

    // Expand/collapse all categories
    var allExpanded = true;
    btnExpand.addEventListener('click', function() {
      allExpanded = !allExpanded;
      categories.forEach(function(cat) {
        cat.style.display = allExpanded ? '' : 'none';
      });
    });

    // Copy to clipboard
    copyBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var arabic = btn.getAttribute('data-arabic');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(arabic).then(function() {
            var orig = btn.textContent;
            btn.textContent = '✅ Disalin!';
            setTimeout(function() { btn.textContent = orig; }, 1500);
          });
        } else {
          // Fallback
          var ta = document.createElement('textarea');
          ta.value = arabic;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          var orig = btn.textContent;
          btn.textContent = '✅ Disalin!';
          setTimeout(function() { btn.textContent = orig; }, 1500);
        }
      });
    });

    // Audio player
    var currentAudio = null;
    var currentBtn = null;
    var audioBtns = document.querySelectorAll('.audio-btn');

    function stopAudio() {
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
        currentAudio = null;
      }
      if (currentBtn) {
        var icon = currentBtn.querySelector('.audio-icon');
        var label = currentBtn.querySelector('.audio-label');
        icon.innerHTML = '<polygon points="5,3 19,12 5,21"/>';
        label.textContent = 'Dengar';
        currentBtn.classList.remove('text-[var(--color-teal)]');
        currentBtn = null;
      }
    }

    audioBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var src = btn.getAttribute('data-audio');
        var icon = btn.querySelector('.audio-icon');
        var label = btn.querySelector('.audio-label');

        if (currentBtn === btn && currentAudio && !currentAudio.paused) {
          currentAudio.pause();
          icon.innerHTML = '<polygon points="5,3 19,12 5,21"/>';
          label.textContent = 'Sambung';
          return;
        }

        if (currentBtn === btn && currentAudio && currentAudio.paused) {
          currentAudio.play();
          icon.innerHTML = '<rect x="5" y="3" width="4" height="18"/><rect x="15" y="3" width="4" height="18"/>';
          label.textContent = 'Jeda';
          return;
        }

        stopAudio();

        currentAudio = new Audio(src);
        currentBtn = btn;
        currentAudio.play().catch(function() {});
        icon.innerHTML = '<rect x="5" y="3" width="4" height="18"/><rect x="15" y="3" width="4" height="18"/>';
        label.textContent = 'Jeda';
        btn.classList.add('text-[var(--color-teal)]');

        currentAudio.addEventListener('ended', function() { stopAudio(); });
        currentAudio.addEventListener('error', function() {
          label.textContent = 'Ralat';
          setTimeout(function() { stopAudio(); }, 2000);
        });
      });
    });

    function filterDoas() {
      var query = searchInput.value.toLowerCase().trim();
      var visibleCount = 0;

      categories.forEach(function(cat) {
        var catId = cat.getAttribute('data-cat');
        var catCards = cat.querySelectorAll('.doa-card');
        var catVisible = 0;

        catCards.forEach(function(card) {
          var matchCat = activeCategory === 'all' || card.getAttribute('data-category') === activeCategory;
          var matchSearch = !query || card.getAttribute('data-title').includes(query) || card.textContent.toLowerCase().includes(query);
          if (matchCat && matchSearch) {
            card.style.display = '';
            catVisible++;
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        cat.style.display = catVisible > 0 ? '' : 'none';
      });

      noResults.style.display = visibleCount === 0 ? '' : 'none';
      doaCount.textContent = 'Menunjukkan ' + visibleCount + ' doa';
    }
  })();
</script>
