---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tools = [
  {
    href: "/alat/kalkulator-dam/",
    title: "Kalkulator Dam",
    description:
      "Kira jenis, kategori, dan kadar dam untuk pelanggaran ihram, dam tamattu, atau wajib haji yang ditinggalkan.",
    icon: "🐑",
  },
  {
    href: "/alat/checklist/",
    title: "Checklist Persiapan Haji",
    description:
      "Senarai semak lengkap — dokumen, pakaian, kesihatan, keperluan harian, ibadah. Progress disimpan automatik.",
    icon: "✅",
  },
  {
    href: "/alat/jadual-haji/",
    title: "Jadual Haji 2026",
    description:
      "Jadual lengkap hari-hari haji — dari 8 Zulhijjah hingga 13 Zulhijjah beserta amalan setiap hari.",
    icon: "📅",
  },
  {
    href: "/alat/kalkulator-kos/",
    title: "Kalkulator Kos Haji 2026",
    description:
      "Anggaran kos haji lengkap — TH Muassasah vs pakej swasta, dam, shopping, penerbangan. Boleh cetak.",
    icon: "💰",
  },
  {
    href: "/alat/doa-harian/",
    title: "Panduan Doa Harian",
    description:
      "12 doa pilihan untuk musafir, masjid, ibadah haji & umrah — Arab, transliterasi, terjemahan. Boleh cetak.",
    icon: "🤲",
  },
  {
    href: "/alat/senarai-beg/",
    title: "Senarai Beg Haji",
    description:
      "Senarai semak 48 item — dokumen, pakaian, ubat, ibadah, elektronik. Simpan progress, boleh cetak.",
    icon: "🧳",
  },
  {
    href: "/alat/wukuf-countdown/",
    title: "Wukuf Countdown",
    description:
      "Kira detik menuju Hari Wukuf Arafah 9 Zulhijjah 1447H. Paparan countdown besar untuk persediaan jemaah.",
    icon: "🕋",
  },
  {
    href: "/alat/qibla/",
    title: "Kompas Kiblat",
    description:
      "Tentukan arah kiblat dari lokasi semasa anda menggunakan GPS dan kompas peranti. Termasuk arah kiblat bandar utama Asia Tenggara.",
    icon: "🧭",
  },
];
---

<BaseLayout
  title="Alat Interaktif Haji & Umrah"
  description="Alat interaktif untuk jemaah haji dan umrah — kalkulator dam, kalkulator kos, checklist persiapan, doa harian, senarai beg, jadual ibadah. Berasaskan fatwa Mufti WP dan kadar Tabung Haji."
>
  <section class="max-w-4xl mx-auto px-4 py-10">
    <header class="mb-10">
      <p class="badge badge-teal mb-4">Alat Interaktif</p>
      <h1
        class="text-4xl md:text-5xl font-semibold text-emerald-900 mb-4"
        style="font-family: var(--font-serif);"
      >
        Alat Untuk Jemaah
      </h1>
      <p class="text-lg text-stone-700 max-w-2xl">
        Alat ringkas, percuma, tanpa pendaftaran. Setiap output disokong
        rujukan rasmi.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {tools.map((t) => (
        <a
          href={t.href}
          class="block bg-white border border-stone-200 rounded-lg p-6 hover:border-emerald-700 hover:shadow-md transition-all"
        >
          <div class="text-4xl mb-3">{t.icon}</div>
          <h2 class="text-xl font-semibold text-emerald-900 mb-2">{t.title}</h2>
          <p class="text-stone-600 text-sm">{t.description}</p>
        </a>
      ))}
    </div>

    <div class="mt-10 text-sm text-stone-500">
      <p>
        Lebih banyak alat dalam pembangunan. Ada cadangan?
        <a href="mailto:info@panduanhajiumrah.com" class="text-emerald-700 underline">Hubungi kami</a>.
      </p>
    </div>
  </section>
</BaseLayout>
