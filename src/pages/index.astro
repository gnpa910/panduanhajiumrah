---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// Latest 6 articles, published only
const articles = (await getCollection("article", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 6);

// Guide chapters grouped by section, sorted by order
const guideEntries = await getCollection("guide", ({ data }) => !data.draft);
const sectionOrder = [
  "persiapan", "ihram-miqat", "umrah", "haji",
  "tempat", "doa-zikir", "hukum-khas", "selepas",
] as const;

const sectionLabels: Record<typeof sectionOrder[number], { ms: string; ar: string }> = {
  persiapan: { ms: "Persiapan", ar: "الاستعداد" },
  "ihram-miqat": { ms: "Ihram & Miqat", ar: "الإحرام والميقات" },
  umrah: { ms: "Umrah", ar: "العمرة" },
  haji: { ms: "Haji", ar: "الحج" },
  tempat: { ms: "Tempat Penting", ar: "الأماكن المقدسة" },
  "doa-zikir": { ms: "Doa & Zikir", ar: "الدعاء والذكر" },
  "hukum-khas": { ms: "Hukum Khas", ar: "أحكام خاصة" },
  selepas: { ms: "Selepas Pulang", ar: "بعد العودة" },
};

const guideBySection = sectionOrder.map((section) => ({
  section,
  ms: sectionLabels[section].ms,
  ar: sectionLabels[section].ar,
  entries: guideEntries
    .filter((e) => e.data.section === section)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((s) => s.entries.length > 0);
---

<BaseLayout
  title="Panduan Lengkap Haji & Umrah dalam Bahasa Melayu"
  description="Panduan A-Z untuk jemaah haji dan umrah Malaysia & Indonesia. Sumber rasmi JAKIM, Mufti Wilayah, Tabung Haji, Kemenag. Setiap fakta disemak terhadap rujukan."
>
  {/* ───────── Hero — kitab cover with verse card ───────── */}
  <section class="pattern-bg">
    <div class="max-w-5xl mx-auto px-4 pt-16 md:pt-20 pb-16 md:pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-center">
        <div>
          <p class="badge badge-teal mb-6">
            Rujukan Bahasa Melayu · Disemak Fakta
          </p>
          <h1
            class="text-5xl md:text-6xl lg:text-7xl font-semibold text-[var(--color-ink)] leading-[1.02] mb-6"
            style="font-family: var(--font-serif); letter-spacing: -0.025em;"
          >
            Panduan Haji <span class="text-[var(--color-saffron)]">&amp;</span> Umrah
            <br />
            <span class="text-[var(--color-stone-warm)] font-normal italic text-3xl md:text-4xl lg:text-5xl">
              untuk jemaah yang membaca dengan teliti.
            </span>
          </h1>
          <p class="text-lg md:text-xl text-[var(--color-stone-warm)] leading-relaxed max-w-xl mb-8">
            Rujukan A–Z dalam Bahasa Melayu, disemak terhadap JAKIM, Mufti Wilayah,
            Tabung Haji, Kemenag RI, sunnah.com, dan quran.com. Setiap hukum dan
            tatacara membawa sumbernya sendiri.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/panduan" class="btn-primary">
              <svg class="btn-icon-star" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0 L14.4 9.6 L24 12 L14.4 14.4 L12 24 L9.6 14.4 L0 12 L9.6 9.6 Z" />
              </svg>
              Mulakan Panduan A–Z
            </a>
            <a href="/artikel" class="btn-secondary">Baca Artikel Terkini</a>
          </div>
        </div>

        {/* Verse card — Quran ayat about Hajj as content-as-hero */}
        <aside class="verse-card">
          <span class="corner-tr" aria-hidden="true"></span>
          <span class="corner-bl" aria-hidden="true"></span>
          <span class="corner-br" aria-hidden="true"></span>
          <p class="verse-source mb-4" style="text-align:center; margin-top:0;">
            Surah Al-Baqarah · 197
          </p>
          <p class="verse-arabic" lang="ar">
            ٱلْحَجُّ أَشْهُرٌ مَّعْلُومَٰتٌ ۚ فَمَن فَرَضَ فِيهِنَّ ٱلْحَجَّ
            فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِى ٱلْحَجِّ
          </p>
          <p class="verse-translation">
            "Musim haji ialah beberapa bulan yang termaklum. Maka sesiapa yang
            mewajibkan dirinya mengerjakan haji itu, maka tidak boleh mencampuri
            isteri, dan tidak boleh fasik, dan tidak boleh bertengkar."
          </p>
          <p class="verse-source mt-4">Rujukan: quran.com/2/197</p>
        </aside>
      </div>
    </div>
    <hr class="rule-saffron" />
  </section>

  {/* ───────── Panduan grid with bilingual section title ───────── */}
  {guideBySection.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 py-16 md:py-20">
      <div class="section-title">
        <div class="flex items-baseline gap-4">
          <h2>Panduan A–Z</h2>
          <span class="arabic-label" lang="ar">الدليل الشامل</span>
        </div>
        <a
          href="/panduan"
          class="text-sm font-semibold text-[var(--color-teal-deep)] hover:text-[var(--color-saffron)] uppercase tracking-[0.12em]"
        >Lihat semua →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {guideBySection.map((group) => (
          <article class="card">
            <div class="flex items-baseline justify-between mb-3 gap-3">
              <span class="badge badge-teal">{group.ms}</span>
              <span class="text-sm text-[var(--color-stone-warm)]" lang="ar" style="font-family: var(--font-arabic); font-size: 1.1rem;">{group.ar}</span>
            </div>
            <ul class="space-y-2 mt-3">
              {group.entries.map((entry) => (
                <li class="flex items-start gap-2">
                  <span class="text-[var(--color-saffron)] mt-1 flex-shrink-0" aria-hidden="true">◆</span>
                  <a
                    href={`/panduan/${entry.data.section}/${entry.id}`}
                    class="text-[var(--color-ink)] hover:text-[var(--color-teal-deep)] underline decoration-transparent hover:decoration-[var(--color-teal)] underline-offset-4 transition-colors"
                  >
                    {entry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  )}

  {/* ───────── Ornament break — 8-point star ───────── */}
  {articles.length > 0 && guideBySection.length > 0 && (
    <div class="ornament max-w-5xl mx-auto px-4" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0 L14.4 9.6 L24 12 L14.4 14.4 L12 24 L9.6 14.4 L0 12 L9.6 9.6 Z" />
      </svg>
    </div>
  )}

  {/* ───────── Artikel terkini — editorial list ───────── */}
  {articles.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 pb-16 md:pb-20">
      <div class="section-title">
        <div class="flex items-baseline gap-4">
          <h2>Artikel Terkini</h2>
          <span class="arabic-label" lang="ar">المقالات الحديثة</span>
        </div>
        <a
          href="/artikel"
          class="text-sm font-semibold text-[var(--color-teal-deep)] hover:text-[var(--color-saffron)] uppercase tracking-[0.12em]"
        >Semua artikel →</a>
      </div>

      <ul class="divide-y divide-[var(--color-rule)]">
        {articles.map((entry) => (
          <li class="py-6 first:pt-0 last:pb-0">
            <article class="grid grid-cols-1 md:grid-cols-[8rem_1fr] gap-3 md:gap-6">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-stone-warm)] md:pt-1">
                {entry.data.publishedAt.toLocaleDateString("ms-MY", {
                  year: "numeric", month: "short", day: "numeric",
                })}
              </p>
              <div>
                <p class="badge badge-teal mb-2">{entry.data.category}</p>
                <h3
                  class="text-xl md:text-2xl font-semibold text-[var(--color-ink)] mb-2 leading-snug"
                  style="font-family: var(--font-serif);"
                >
                  <a
                    href={`/artikel/${entry.data.category}/${entry.id}`}
                    class="hover:text-[var(--color-teal-deep)] transition-colors"
                  >
                    {entry.data.title}
                  </a>
                </h3>
                <p class="text-[var(--color-stone-warm)] leading-relaxed">
                  {entry.data.description}
                </p>
                {entry.data.readingMinutes && (
                  <p class="mt-2 text-xs text-[var(--color-stone-warm)] uppercase tracking-[0.12em]">
                    {entry.data.readingMinutes} min bacaan
                  </p>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ───────── Trust strip — sources ───────── */}
  <section class="border-t border-[var(--color-rule)] bg-[var(--color-surface-soft)]">
    <div class="max-w-5xl mx-auto px-4 py-10 md:py-14">
      <div class="flex items-baseline justify-between mb-6 gap-4 flex-wrap">
        <div class="flex items-baseline gap-3">
          <p class="badge badge-teal">Sumber Rasmi</p>
          <span class="text-sm text-[var(--color-stone-warm)]" lang="ar" style="font-family: var(--font-arabic); font-size: 1.1rem;">المصادر الرسمية</span>
        </div>
        <p class="text-xs text-[var(--color-stone-warm)] uppercase tracking-[0.12em] font-semibold">
          Setiap fakta disemak silang
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        <span class="source-pill">JAKIM e-Fatwa</span>
        <span class="source-pill">Mufti Wilayah</span>
        <span class="source-pill">Tabung Haji</span>
        <span class="source-pill">Kemenag RI</span>
        <span class="source-pill">sunnah.com</span>
        <span class="source-pill">quran.com</span>
      </div>
    </div>
  </section>

  {guideBySection.length === 0 && articles.length === 0 && (
    <section class="max-w-2xl mx-auto px-4 py-24 text-center">
      <p class="badge badge-teal mb-4">Akan Datang</p>
      <p
        class="text-2xl text-[var(--color-ink)]"
        style="font-family: var(--font-serif);"
      >
        Kandungan akan diterbitkan tidak lama lagi.
      </p>
      <p class="mt-3 text-[var(--color-stone-warm)]">Kembali kemudian.</p>
    </section>
  )}
</BaseLayout>
