---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("article", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const categories = ["persoalan", "muzakarah", "berita", "pengalaman"] as const;
const categoryLabels: Record<typeof categories[number], string> = {
  persoalan: "Persoalan",
  muzakarah: "Muzakarah",
  berita: "Berita",
  pengalaman: "Pengalaman",
};
---

<BaseLayout
  title="Artikel Haji & Umrah Terkini"
  description="Persoalan khusus, hasil muzakarah tahunan, berita pakej dan kuota, serta pengalaman jemaah haji dan umrah."
>
  <section class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-bold text-emerald-900 mb-4">Artikel Terkini</h1>
    <p class="text-lg text-stone-700 mb-8">
      Persoalan khusus, hasil muzakarah, berita kuota, dan pengalaman jemaah.
      Untuk panduan A-Z evergreen, lihat <a href="/panduan" class="text-emerald-700 underline">Panduan</a>.
    </p>

    <div class="flex flex-wrap gap-2 mb-6">
      {categories.map((cat) => (
        <a href={`#${cat}`} class="text-sm px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full hover:bg-emerald-200">
          {categoryLabels[cat]}
        </a>
      ))}
    </div>

    {articles.length === 0 ? (
      <p class="text-stone-500 italic">Artikel akan diterbitkan tidak lama lagi.</p>
    ) : (
      <div class="space-y-8">
        {categories.map((cat) => {
          const items = articles.filter((a) => a.data.category === cat);
          if (items.length === 0) return null;
          return (
            <section id={cat}>
              <h2 class="text-2xl font-semibold text-emerald-800 mb-4">{categoryLabels[cat]}</h2>
              <ul class="space-y-4">
                {items.map((entry) => (
                  <li class="bg-white border border-stone-200 rounded-lg p-4 hover:border-emerald-300">
                    <h3 class="text-lg font-semibold text-stone-900 mb-1">
                      <a href={`/artikel/${entry.data.category}/${entry.id}`} class="hover:text-emerald-700">
                        {entry.data.title}
                      </a>
                    </h3>
                    <p class="text-stone-700 text-sm mb-1">{entry.data.description}</p>
                    <p class="text-xs text-stone-500">
                      {entry.data.publishedAt.toLocaleDateString("ms-MY", {
                        year: "numeric", month: "long", day: "numeric",
                      })}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    )}
  </section>
</BaseLayout>
