---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShareButtons from "../../../components/ShareButtons.astro";
import TableOfContents from "../../../components/TableOfContents.astro";

export async function getStaticPaths() {
  const articles = await getCollection("article", ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { category: entry.data.category, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const categoryLabels: Record<string, string> = {
  persoalan: "Persoalan",
  muzakarah: "Muzakarah",
  berita: "Berita",
  pengalaman: "Pengalaman",
};

const author = await getEntry(entry.data.author);
const siteUrl = Astro.site ?? new URL("https://panduanhajiumrah.vercel.app");
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const categoryLabel = categoryLabels[entry.data.category] ?? entry.data.category;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": entry.data.category === "berita" ? "NewsArticle" : "Article",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
  author: {
    "@type": "Person",
    name: author?.data.name ?? "Aiman",
  },
  publisher: {
    "@type": "Organization",
    name: "Panduan Haji & Umrah",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", siteUrl).href,
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  inLanguage: "ms-MY",
  isAccessibleForFree: true,
  keywords: entry.data.tags.join(", "),
  citation: entry.data.sources.map((s) => ({
    "@type": "CreativeWork",
    name: s.label,
    url: s.url,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Laman Utama", item: siteUrl.href },
    { "@type": "ListItem", position: 2, name: "Artikel", item: new URL("/artikel/", siteUrl).href },
    { "@type": "ListItem", position: 3, name: categoryLabel, item: new URL(`/artikel/${entry.data.category}/`, siteUrl).href },
    { "@type": "ListItem", position: 4, name: entry.data.title, item: pageUrl },
  ],
};

// Related articles — same category, exclude self, 3 most recent
const allArticles = await getCollection("article", ({ data }) => !data.draft);
const relatedSameCategory = allArticles
  .filter((a) => a.data.category === entry.data.category && a.id !== entry.id)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

// Related guides — from frontmatter relatedGuides[]
const relatedGuideEntries = entry.data.relatedGuides
  ? await Promise.all(
      entry.data.relatedGuides.map((ref) => getEntry(ref).catch(() => null))
    )
  : [];
const validRelatedGuides = relatedGuideEntries.filter(
  (g): g is NonNullable<typeof g> => g !== null && !g.data.draft
);

// FAQ JSON-LD — only emit if frontmatter.faq present
const faqSchema = entry.data.faq && entry.data.faq.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: entry.data.faq.map((qa) => ({
        "@type": "Question",
        name: qa.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: qa.answer,
        },
      })),
    }
  : null;

const pageSchemas: Record<string, unknown>[] = [articleSchema, breadcrumbSchema];
if (faqSchema) pageSchemas.push(faqSchema);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  jsonLd={pageSchemas}
>
  {/* Visible breadcrumb */}
  <nav class="max-w-5xl mx-auto px-4 pt-6 text-sm text-[var(--color-stone-warm)]" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-x-1 gap-y-1">
      <li><a href="/" class="hover:text-[var(--color-saffron)] hover:underline">Laman Utama</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/artikel/" class="hover:text-[var(--color-saffron)] hover:underline">Artikel</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={`/artikel/${entry.data.category}/`} class="hover:text-[var(--color-saffron)] hover:underline">
          {categoryLabel}
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li class="text-[var(--color-ink)] truncate max-w-[16rem]" aria-current="page">{entry.data.title}</li>
    </ol>
  </nav>

  <div class="toc-container">
  <TableOfContents />
  <article class="prose-haji">
    <p class="text-sm text-[var(--color-stone-warm)] uppercase tracking-wide mb-2">
      Artikel / {categoryLabels[entry.data.category] ?? entry.data.category}
    </p>
    <p class="text-lg text-stone-600 mb-6">{entry.data.description}</p>

    {entry.data.factChecked && entry.data.factCheckedAt && (
      <div class="flex items-center gap-2 mb-6 px-3 py-2 rounded-md bg-emerald-50 border border-emerald-200 text-sm text-emerald-800 w-fit">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 12l2 2 4-4"></path>
          <circle cx="12" cy="12" r="10"></circle>
        </svg>
        <span class="font-medium">
          Disemak fakta · {entry.data.factCheckedAt.toLocaleDateString("ms-MY", {
            year: "numeric", month: "short", day: "numeric",
          })}
        </span>
        <span class="text-emerald-600">·</span>
        <a href="/tentang/#semakan-fakta" class="text-emerald-700 hover:text-emerald-900 underline decoration-emerald-300 underline-offset-2">
          Bagaimana
        </a>
      </div>
    )}

    <p class="text-sm text-[var(--color-stone-warm)] mb-8">
      Diterbitkan {entry.data.publishedAt.toLocaleDateString("ms-MY", {
        year: "numeric", month: "long", day: "numeric",
      })}
      {entry.data.updatedAt && ` · Dikemaskini ${entry.data.updatedAt.toLocaleDateString("ms-MY", {
        year: "numeric", month: "long", day: "numeric",
      })}`}
      {entry.data.readingMinutes && ` · ${entry.data.readingMinutes} min bacaan`}
      <span id="reading-time" class="hidden"></span>
    </p>

    {entry.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {entry.data.tags.map((tag) => (
          <a
            href={`/tag/${tag}/`}
            class="text-xs px-2 py-0.5 bg-stone-200 text-stone-700 rounded hover:bg-[var(--color-saffron)] hover:text-white transition-colors"
          >#{tag}</a>
        ))}
      </div>
    )}

    <ShareButtons title={entry.data.title} url={pageUrl} />

    <Content />
    {!entry.data.readingMinutes && (
      <script is:inline>
        (function(){
          var el=document.querySelector('.prose-haji');
          if(!el)return;
          var text=el.textContent||'';
          var words=text.trim().split(/\s+/).filter(Boolean).length;
          var mins=Math.max(1,Math.round(words/200));
          var rt=document.getElementById('reading-time');
          if(rt){rt.textContent=' · '+mins+' min bacaan';rt.classList.remove('hidden');}
        })();
      </script>
    )}

    {entry.data.faq && entry.data.faq.length > 0 && (
      <section class="mt-12 mb-8">
        <h2 class="text-2xl font-semibold text-[var(--color-ink)] mb-2" style="font-family: var(--font-serif);">
          Soalan lazim
        </h2>
        <p class="text-sm text-[var(--color-stone-warm)] mb-6">
          Ringkasan soalan paling kerap ditanya berkaitan topik ini.
        </p>
        <div class="space-y-3">
          {entry.data.faq.map((qa) => (
            <details class="group border border-[var(--color-rule)] rounded-lg bg-white">
              <summary class="cursor-pointer list-none p-4 flex items-start justify-between gap-3 hover:bg-stone-50 rounded-lg">
                <span class="font-medium text-[var(--color-ink)] flex-1">{qa.question}</span>
                <svg
                  class="flex-shrink-0 mt-1 text-[var(--color-stone-warm)] transition-transform group-open:rotate-180"
                  width="18" height="18" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="px-4 pb-4 pt-1 text-stone-700 leading-relaxed border-t border-[var(--color-rule)]">
                <p class="pt-3">{qa.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <div class="source-list">
      <h3>Rujukan</h3>
      <ol class="list-decimal pl-6 space-y-1">
        {entry.data.sources.map((src) => (
          <li>
            <a href={src.url} target="_blank" rel="noopener noreferrer">{src.label}</a>
            <span class="text-[var(--color-stone-warm)] text-xs">
              {" "}— diakses {src.accessedAt.toLocaleDateString("ms-MY")}
            </span>
            {src.excerpt && (
              <p class="text-stone-600 text-xs italic ml-4 mt-1">"{src.excerpt}"</p>
            )}
          </li>
        ))}
      </ol>
    </div>
  </article>
  </div>

  {/* Related: guide chapters from frontmatter */}
  {validRelatedGuides.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 mt-16">
      <div class="border-t border-[var(--color-rule)] pt-10">
        <p class="badge badge-teal mb-4">Panduan Berkaitan</p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {validRelatedGuides.map((g) => (
            <li>
              <a
                href={`/panduan/${g.data.section}/${g.id}/`}
                class="block p-5 border border-[var(--color-rule)] rounded-lg hover:border-[var(--color-saffron)] transition-colors"
              >
                <p class="text-xs uppercase tracking-[0.12em] text-[var(--color-stone-warm)] mb-1">
                  Panduan / {g.data.section.replace("-", " ")}
                </p>
                <p class="font-semibold text-[var(--color-ink)] mb-1" style="font-family: var(--font-serif);">
                  {g.data.title}
                </p>
                <p class="text-sm text-[var(--color-stone-warm)] line-clamp-2">{g.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Related: more from same category */}
  {relatedSameCategory.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 mt-12 pb-16">
      <div class="border-t border-[var(--color-rule)] pt-10">
        <div class="flex items-baseline justify-between mb-6 gap-4 flex-wrap">
          <p class="badge badge-teal">Lagi {categoryLabel}</p>
          <a href={`/artikel/${entry.data.category}/`} class="text-sm font-semibold text-[var(--color-teal-deep)] hover:text-[var(--color-saffron)] uppercase tracking-[0.12em]">
            Semua →
          </a>
        </div>
        <ul class="space-y-4">
          {relatedSameCategory.map((rel) => (
            <li>
              <a
                href={`/artikel/${rel.data.category}/${rel.id}/`}
                class="block py-3 border-b border-[var(--color-rule)] hover:bg-stone-50 transition-colors -mx-2 px-2 rounded"
              >
                <h3 class="font-semibold text-[var(--color-ink)] mb-1" style="font-family: var(--font-serif);">
                  {rel.data.title}
                </h3>
                <p class="text-sm text-[var(--color-stone-warm)] line-clamp-2">{rel.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
