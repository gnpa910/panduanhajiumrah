---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("article", ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { category: entry.data.category, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const categoryLabels: Record<string, string> = {
  persoalan: "Persoalan",
  muzakarah: "Muzakarah",
  berita: "Berita",
  pengalaman: "Pengalaman",
};

const author = await getEntry(entry.data.author);
const siteUrl = Astro.site ?? new URL("https://panduanhajiumrah.vercel.app");
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const categoryLabel = categoryLabels[entry.data.category] ?? entry.data.category;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": entry.data.category === "berita" ? "NewsArticle" : "Article",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
  author: {
    "@type": "Person",
    name: author?.data.name ?? "Aiman",
  },
  publisher: {
    "@type": "Organization",
    name: "Panduan Haji & Umrah",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", siteUrl).href,
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  inLanguage: "ms-MY",
  isAccessibleForFree: true,
  keywords: entry.data.tags.join(", "),
  citation: entry.data.sources.map((s) => ({
    "@type": "CreativeWork",
    name: s.label,
    url: s.url,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Laman Utama", item: siteUrl.href },
    { "@type": "ListItem", position: 2, name: "Artikel", item: new URL("/artikel/", siteUrl).href },
    { "@type": "ListItem", position: 3, name: categoryLabel, item: new URL(`/artikel/${entry.data.category}/`, siteUrl).href },
    { "@type": "ListItem", position: 4, name: entry.data.title, item: pageUrl },
  ],
};

// Related articles — same category, exclude self, 3 most recent
const allArticles = await getCollection("article", ({ data }) => !data.draft);
const relatedSameCategory = allArticles
  .filter((a) => a.data.category === entry.data.category && a.id !== entry.id)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

// Related guides — from frontmatter relatedGuides[]
const relatedGuideEntries = entry.data.relatedGuides
  ? await Promise.all(
      entry.data.relatedGuides.map((ref) => getEntry(ref).catch(() => null))
    )
  : [];
const validRelatedGuides = relatedGuideEntries.filter(
  (g): g is NonNullable<typeof g> => g !== null && !g.data.draft
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  {/* Visible breadcrumb */}
  <nav class="max-w-5xl mx-auto px-4 pt-6 text-sm text-[var(--color-stone-warm)]" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-x-1 gap-y-1">
      <li><a href="/" class="hover:text-[var(--color-saffron)] hover:underline">Laman Utama</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/artikel/" class="hover:text-[var(--color-saffron)] hover:underline">Artikel</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={`/artikel/${entry.data.category}/`} class="hover:text-[var(--color-saffron)] hover:underline">
          {categoryLabel}
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li class="text-[var(--color-ink)] truncate max-w-[16rem]" aria-current="page">{entry.data.title}</li>
    </ol>
  </nav>

  <article class="prose-haji">
    <p class="text-sm text-stone-500 uppercase tracking-wide mb-2">
      Artikel / {categoryLabels[entry.data.category] ?? entry.data.category}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="text-lg text-stone-600 mb-6">{entry.data.description}</p>
    <p class="text-sm text-stone-500 mb-8">
      Diterbitkan {entry.data.publishedAt.toLocaleDateString("ms-MY", {
        year: "numeric", month: "long", day: "numeric",
      })}
      {entry.data.updatedAt && ` · Dikemaskini ${entry.data.updatedAt.toLocaleDateString("ms-MY", {
        year: "numeric", month: "long", day: "numeric",
      })}`}
      {entry.data.readingMinutes && ` · ${entry.data.readingMinutes} min bacaan`}
    </p>

    {entry.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {entry.data.tags.map((tag) => (
          <span class="text-xs px-2 py-0.5 bg-stone-200 text-stone-700 rounded">#{tag}</span>
        ))}
      </div>
    )}

    <Content />

    <div class="source-list">
      <h3>Rujukan</h3>
      <ol class="list-decimal pl-6 space-y-1">
        {entry.data.sources.map((src) => (
          <li>
            <a href={src.url} target="_blank" rel="noopener noreferrer">{src.label}</a>
            <span class="text-stone-500 text-xs">
              {" "}— diakses {src.accessedAt.toLocaleDateString("ms-MY")}
            </span>
            {src.excerpt && (
              <p class="text-stone-600 text-xs italic ml-4 mt-1">"{src.excerpt}"</p>
            )}
          </li>
        ))}
      </ol>
      {entry.data.factChecked && entry.data.factCheckedAt && (
        <p class="mt-4 text-emerald-700">
          ✓ Disemak fakta pada {entry.data.factCheckedAt.toLocaleDateString("ms-MY")}
          {entry.data.factCheckedBy && ` oleh ${entry.data.factCheckedBy}`}
        </p>
      )}
    </div>
  </article>

  {/* Related: guide chapters from frontmatter */}
  {validRelatedGuides.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 mt-16">
      <div class="border-t border-[var(--color-rule)] pt-10">
        <p class="badge badge-teal mb-4">Panduan Berkaitan</p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {validRelatedGuides.map((g) => (
            <li>
              <a
                href={`/panduan/${g.data.section}/${g.id}/`}
                class="block p-5 border border-[var(--color-rule)] rounded-lg hover:border-[var(--color-saffron)] transition-colors"
              >
                <p class="text-xs uppercase tracking-[0.12em] text-[var(--color-stone-warm)] mb-1">
                  Panduan / {g.data.section.replace("-", " ")}
                </p>
                <p class="font-semibold text-[var(--color-ink)] mb-1" style="font-family: var(--font-serif);">
                  {g.data.title}
                </p>
                <p class="text-sm text-[var(--color-stone-warm)] line-clamp-2">{g.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Related: more from same category */}
  {relatedSameCategory.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 mt-12 pb-16">
      <div class="border-t border-[var(--color-rule)] pt-10">
        <div class="flex items-baseline justify-between mb-6 gap-4 flex-wrap">
          <p class="badge badge-teal">Lagi {categoryLabel}</p>
          <a href={`/artikel/${entry.data.category}/`} class="text-sm font-semibold text-[var(--color-teal-deep)] hover:text-[var(--color-saffron)] uppercase tracking-[0.12em]">
            Semua →
          </a>
        </div>
        <ul class="space-y-4">
          {relatedSameCategory.map((rel) => (
            <li>
              <a
                href={`/artikel/${rel.data.category}/${rel.id}/`}
                class="block py-3 border-b border-[var(--color-rule)] hover:bg-stone-50 transition-colors -mx-2 px-2 rounded"
              >
                <h3 class="font-semibold text-[var(--color-ink)] mb-1" style="font-family: var(--font-serif);">
                  {rel.data.title}
                </h3>
                <p class="text-sm text-[var(--color-stone-warm)] line-clamp-2">{rel.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
