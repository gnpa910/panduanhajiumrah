---
import "../styles/global.css";
import BackToTop from "../components/BackToTop.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  /** Schema.org structured data, JSON-serializable */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Optional canonical override (defaults to current URL) */
  canonicalUrl?: string;
}

const {
  title,
  description,
  ogType = "website",
  publishedAt,
  updatedAt,
  jsonLd,
  canonicalUrl,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://panduanhajiumrah.vercel.app");
const canonical = canonicalUrl
  ? new URL(canonicalUrl, siteUrl)
  : new URL(Astro.url.pathname, siteUrl);
const siteName = "Panduan Haji & Umrah";
const ogImage = new URL("/og-default.png", siteUrl).href;

// Default WebSite + Organization schema
const defaultSchema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteUrl.href,
    inLanguage: "ms-MY",
    description:
      "Sumber rujukan haji dan umrah berbahasa Melayu — fatwa Mufti Wilayah, hadis sahih, panduan Tabung Haji.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteName,
    url: siteUrl.href,
    logo: new URL("/favicon.svg", siteUrl).href,
  },
];

const schemas = jsonLd
  ? [...defaultSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : defaultSchema;
---

<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0F2922" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Brand fonts: self-hosted via /fonts/ — see src/styles/global.css -->
    <!-- Preload LCP-critical font subsets (latin only). Cuts FOUT delay on first paint. -->
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={siteName} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Prevent FOUC — apply theme before first paint */}
    <script is:inline>
      (function(){var t=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',t)})();
    </script>

    <!-- Structured data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Lompat ke kandungan utama</a>
    <header class="border-b border-[var(--color-rule)] bg-[var(--color-paper)]">
      <nav
        class="max-w-5xl mx-auto px-4 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3 md:gap-0"
        aria-label="Utama"
      >
        <a
          href="/"
          class="flex items-center gap-3 text-[var(--color-ink)] hover:text-[var(--color-saffron)] transition-colors"
        >
          <svg
            width="28" height="28" viewBox="0 0 24 24"
            class="text-[var(--color-saffron)] flex-shrink-0"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 0 L14.4 9.6 L24 12 L14.4 14.4 L12 24 L9.6 14.4 L0 12 L9.6 9.6 Z" />
          </svg>
          <span
            class="text-xl md:text-2xl font-semibold tracking-tight"
            style="font-family: var(--font-serif);"
          >
            Panduan Haji <span class="text-[var(--color-saffron)]">&amp;</span> Umrah
          </span>
        </a>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 md:gap-8 text-sm font-medium text-[var(--color-stone-warm)] -mx-1 md:mx-0">
          <li>
            <a
              href="/panduan"
              class="block px-1 py-1 hover:text-[var(--color-teal-deep)] transition-colors"
            >Panduan A–Z</a>
          </li>
          <li>
            <a
              href="/artikel"
              class="block px-1 py-1 hover:text-[var(--color-teal-deep)] transition-colors"
            >Artikel</a>
          </li>
          <li>
            <a
              href="/tentang"
              class="block px-1 py-1 hover:text-[var(--color-teal-deep)] transition-colors"
            >Tentang</a>
          </li>
          <li>
            <a
              href="/cari"
              class="block px-1 py-1 hover:text-[var(--color-teal-deep)] transition-colors"
              aria-label="Cari"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline -mt-0.5" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              Cari
            </a>
          </li>
          <li class="flex items-center">
            <ThemeToggle />
          </li>
        </ul>
      </nav>
      <hr class="rule-saffron" />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-[var(--color-rule)] bg-[var(--color-surface-soft)]">
      <div class="max-w-5xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-[var(--color-stone-warm)]">
          <div>
            <p class="badge mb-3">Sumber</p>
            <p class="leading-relaxed">
              JAKIM e-Fatwa, Mufti Wilayah Persekutuan, Tabung Haji,
              Kemenag RI, sunnah.com, quran.com.
            </p>
          </div>
          <div>
            <p class="badge mb-3">Semakan</p>
            <p class="leading-relaxed">
              Setiap artikel disemak fakta terhadap sumber rasmi sebelum
              diterbitkan.
            </p>
          </div>
          <div>
            <p class="badge mb-3">Disclaimer</p>
            <p class="leading-relaxed">
              Panduan umum berdasarkan rujukan rasmi pada tarikh ditulis.
              Hukum boleh berbeza mengikut mazhab dan keadaan individu —
              rujuk pegawai agama bertauliah. Kami bukan agensi haji/umrah
              dan tidak menjual pakej.
            </p>
          </div>
        </div>

        <hr class="rule-saffron mt-10 mb-6" />

        <div class="flex flex-col md:flex-row justify-between gap-3 text-xs text-[var(--color-stone-warm)]">
          <p>
            <a
              href="/tentang"
              class="text-[var(--color-ink)] underline decoration-[var(--color-saffron)] underline-offset-4 hover:text-[var(--color-saffron)]"
            >Tentang &amp; sumber rujukan penuh</a>
          </p>
          <p>© {new Date().getFullYear()} Panduan Haji &amp; Umrah</p>
        </div>
      </div>
    </footer>
  <BackToTop />
  </body>
</html>
